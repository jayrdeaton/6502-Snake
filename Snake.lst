000000r 1               ; =============================================================================
000000r 1               ;   Snake.asm — cartridge entry point, title screen, and main loop
000000r 1               ; =============================================================================
000000r 1               ;   A classic grid-based Snake game for the AC6502 family, built as a
000000r 1               ;   standalone ROM cartridge (6502-CRT template). Boots directly, no BASIC.
000000r 1               ;
000000r 1               ;   Controls: WASD, arrow keys, or joystick 1 to move. Space or fire to
000000r 1               ;   start / restart, and to pause / resume during play.
000000r 1               ; =============================================================================
000000r 1               
000000r 1               .setcpu "65C02"
000000r 1               
000000r 1               .include "6502.inc"
000000r 2               ; =============================================================================
000000r 2               ;   6502.inc — External include file for the 6502 system
000000r 2               ; =============================================================================
000000r 2               ;
000000r 2               ;   CPU:       WDC 65C02S
000000r 2               ;   BIOS:      v1.5
000000r 2               ;   Assembler: ca65 (cc65 toolchain) — uses := for absolute symbols
000000r 2               ;
000000r 2               ;   Include this file in external projects to access Kernal routines,
000000r 2               ;   IO hardware registers, system variables, and useful constants.
000000r 2               ;
000000r 2               ;   MEMORY MAP
000000r 2               ;   ----------
000000r 2               ;   $0000-$0003   Zero Page: System pointers (see below)
000000r 2               ;   $0004-$0023   Zero Page: Reserved by BASIC interpreter
000000r 2               ;   $0024-$0039   Zero Page: System scratch (CF, serial, delay, monitor, XModem)
000000r 2               ;   $003A-$00FF   Zero Page: Free for a program that has taken the machine over
000000r 2               ;                 (not underneath a running BASIC, which uses it as it interprets)
000000r 2               ;   $0100-$01FF   CPU Stack
000000r 2               ;   $0200-$02FF   Input Buffer (ring buffer, managed by Kernal)
000000r 2               ;   $0300-$03FF   Kernal Variables (vectors, cursor, HW flags, etc.)
000000r 2               ;   $0400-$04FF   BAS_LINBUF: BASIC's raw input line (NOT user memory, despite
000000r 2               ;                 BIOS.inc naming $0400 USER_VARS -- a legacy name kept only
000000r 2               ;                 because Wozmon builds its input buffer there)
000000r 2               ;   $0500-$05FF   BAS_TOKBUF: BASIC's tokenizing scratch
000000r 2               ;   $0600-$07FF   FS sector buffer (clobbered by any FS/St routine call)
000000r 2               ;   $0800-$7FFF   Program RAM (30 KB — load address for user code)
000000r 2               ;   $8000-$83FF   IO 1: Banked RAM Low  (256 × ~1 KB banks)
000000r 2               ;   $8400-$87FF   IO 2: Banked RAM High (256 × ~1 KB banks)
000000r 2               ;   $8800-$881F   IO 3: RTC (DS1511Y)
000000r 2               ;   $8C00-$8C07   IO 4: Storage (CompactFlash, 8-bit IDE)
000000r 2               ;   $9000-$9003   IO 5: Serial (R65C51 ACIA)
000000r 2               ;   $9400-$940F   IO 6: GPIO (65C22 VIA — keyboard & joysticks)
000000r 2               ;   $9800-$981C   IO 7: Sound (SID / ARMSID)
000000r 2               ;   $9C00-$9C01   IO 8: Video (TMS9918 / pico9918)
000000r 2               ;   $A000-$A0FF   Kernal Jump Table (stable entry points)
000000r 2               ;   $A100-$B7FF   Kernal Implementation
000000r 2               ;   $B800-$BFFF   Character Set ROM (2 KB, 256 × 8-byte patterns)
000000r 2               ;   $C000-$EDFF   BASIC Interpreter
000000r 2               ;   $EE00-$FEFF   Machine Code Monitor
000000r 2               ;   $FF00-$FFF9   Wozmon (mini monitor)
000000r 2               ;   $FFFA-$FFFF   CPU Vectors (NMI, RESET, IRQ)
000000r 2               ;
000000r 2               ;   BOOT SEQUENCE
000000r 2               ;   -------------
000000r 2               ;   On RESET the BIOS probes all eight IO slots, initializes detected
000000r 2               ;   hardware, and auto-selects video or serial console.  If neither is
000000r 2               ;   found, IO_MODE is left unchanged (no halt — cartridges with their
000000r 2               ;   own display hardware can still boot).  A startup beep plays (if SID
000000r 2               ;   is present) for audible feedback, then BOOT_VECTOR ($035B) is
000000r 2               ;   checked — if non-zero, execution jumps there (cartridge takeover).
000000r 2               ;   Otherwise a console check halts if no video/serial is found, then
000000r 2               ;   the splash screen and boot menu are displayed.  ENTER launches
000000r 2               ;   BASIC; ESC enters the Monitor.  A 5-second timeout auto-boots BASIC.
000000r 2               ;   The splash is drawn on whichever console is active — centred on the
000000r 2               ;   40-column screen, or left-aligned as plain text over serial.
000000r 2               ;
000000r 2               ;   GRACEFUL DEGRADATION
000000r 2               ;   --------------------
000000r 2               ;   Every Kernal routine that drives a card checks HW_PRESENT first, so
000000r 2               ;   a call on a machine without that card is safe rather than a crash.
000000r 2               ;   Routines with nothing to report back return silently (video and SID);
000000r 2               ;   routines that move data report failure in the carry (CompactFlash).
000000r 2               ;   The per-routine notes below say which behaviour each one has.
000000r 2               ;
000000r 2               ;   CARTRIDGE SUPPORT
000000r 2               ;   -----------------
000000r 2               ;   Cartridges overlay $C000-$FFFF (BASIC, Monitor, Wozmon, vectors).
000000r 2               ;   The Kernal ($A000-$B7FF) and character set ($B800-$BFFF) remain
000000r 2               ;   accessible.  Use KernalInit ($A078) to initialize all hardware and
000000r 2               ;   return via RTS — interrupts are left disabled so the cart can set
000000r 2               ;   up its own handlers first.  See usage patterns in the BIOS README.
000000r 2               ;
000000r 2               ;   IO_MODE
000000r 2               ;   -------
000000r 2               ;   Bit 0 of IO_MODE selects the console output device:
000000r 2               ;     0 = Video (TMS9918)    1 = Serial (R65C51)
000000r 2               ;   Chrout ($A000) dispatches automatically based on IO_MODE.
000000r 2               ;   Use SetIOMode / GetIOMode to change or query the active console.
000000r 2               ;
000000r 2               ;   CALLING CONVENTION
000000r 2               ;   ------------------
000000r 2               ;   Kernal routines are called via JSR to the jump table addresses below.
000000r 2               ;   Parameters are passed in A, X, Y, and/or zero-page pointers as
000000r 2               ;   documented per routine.  Carry flag is used for success/error returns
000000r 2               ;   (C=0 success, C=1 error) where noted.
000000r 2               ;
000000r 2               ;   HW_PRESENT BITMASK
000000r 2               ;   -------------------
000000r 2               ;   After boot, HW_PRESENT ($030D) contains a bitmask of detected hardware.
000000r 2               ;   Test individual bits before calling hardware-specific routines.
000000r 2               ;   Example:
000000r 2               ;     lda HW_PRESENT
000000r 2               ;     and #HW_VID          ; Is video card present?
000000r 2               ;     beq @NoVideo         ; Skip if not
000000r 2               ;
000000r 2               ; =============================================================================
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 1: ZERO PAGE POINTERS
000000r 2               ; =============================================================================
000000r 2               ; These zero page locations are used by the Kernal.  External programs may
000000r 2               ; use STR_PTR and CF_BUF_PTR/CF_LBA as parameters to Kernal calls.
000000r 2               ; Locations $3A-$FF are free for user programs.
000000r 2               
000000r 2               STR_PTR             := $02               ; 2 bytes — String pointer (used by FsLoadFile, FsSaveFile, FsDeleteFile, etc.)
000000r 2               CF_BUF_PTR          := $24               ; 2 bytes — CF sector data buffer pointer
000000r 2               CF_LBA              := $26               ; 4 bytes — CF 28-bit LBA address (little-endian)
000000r 2               XFER_PTR            := $2A               ; 2 bytes — XModem transfer data pointer (source for XModemSave, dest for XModemLoad)
000000r 2               
000000r 2               ; Safe zero page range for user programs:
000000r 2               ; $3A-$FF (198 bytes free)
000000r 2               ; Note: $2E-$35 belong to the Monitor and $36-$39 to XModemLoad/XModemSave;
000000r 2               ;       neither range survives a call into those routines
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 2: SYSTEM VARIABLES ($0300-$03FF)
000000r 2               ; =============================================================================
000000r 2               
000000r 2               IRQ_PTR             := $0300             ; 2 bytes — IRQ handler vector (writable; default: internal Irq handler)
000000r 2               BRK_PTR             := $0302             ; 2 bytes — BRK handler vector (writable; default: enters Monitor)
000000r 2               NMI_PTR             := $0304             ; 2 bytes — NMI handler vector (writable; default: RTI)
000000r 2               
000000r 2               IO_MODE             := $0306             ; 1 byte  — Console output mode (bit 0: 0=video, 1=serial)
000000r 2               VID_CURSOR_X        := $0307             ; 1 byte  — Video cursor column (0-39)
000000r 2               VID_CURSOR_Y        := $0308             ; 1 byte  — Video cursor row (0-23)
000000r 2               
000000r 2               HW_PRESENT          := $030D             ; 1 byte  — Hardware present bitmask (set during boot probe)
000000r 2               CF_DISK             := $030F             ; 1 byte  — Current CF disk bank (0–255); base LBA = CF_DISK × FS_DISK_SECTORS; reset to 0 on boot
000000r 2               
000000r 2               ; HW_PRESENT bit definitions (bit order matches IO slot numbers):
000000r 2               HW_RAM_L            = %00000001          ; Bit 0: RAM card low  (IO 1, $8000-$83FF)
000000r 2               HW_RAM_H            = %00000010          ; Bit 1: RAM card high (IO 2, $8400-$87FF)
000000r 2               HW_RTC              = %00000100          ; Bit 2: RTC card      (IO 3, DS1511Y)
000000r 2               HW_CF               = %00001000          ; Bit 3: Storage card   (IO 4, CompactFlash)
000000r 2               HW_SC               = %00010000          ; Bit 4: Serial card    (IO 5, R65C51)
000000r 2               HW_GPIO             = %00100000          ; Bit 5: GPIO card      (IO 6, 65C22 VIA — keyboard/joysticks)
000000r 2               HW_SID              = %01000000          ; Bit 6: Sound card     (IO 7, SID/ARMSID)
000000r 2               HW_VID              = %10000000          ; Bit 7: Video card     (IO 8, TMS9918/pico9918)
000000r 2               
000000r 2               ; BRK register save area (populated by the BRK handler before entering Monitor):
000000r 2               BRK_P               := $0310             ; Saved processor status (P)
000000r 2               BRK_PCL             := $0311             ; Saved PC low byte (points to BRK instruction + 2)
000000r 2               BRK_PCH             := $0312             ; Saved PC high byte
000000r 2               BRK_A               := $0313             ; Saved accumulator
000000r 2               BRK_X               := $0314             ; Saved X register
000000r 2               BRK_Y               := $0315             ; Saved Y register
000000r 2               BRK_SP              := $0316             ; Saved stack pointer
000000r 2               
000000r 2               XFER_REMAIN         := $0317             ; 2 bytes — XModem byte count (output from XModemLoad; input to XModemSave)
000000r 2               XFER_IO_SAVE        := $0319             ; 1 byte  — Saved IO_MODE during XModem transfer (internal use)
000000r 2               
000000r 2               ; RTC scratch (used by RtcWriteDate to pass century):
000000r 2               RTC_BUF_CENT        := $030B             ; Century value for RtcReadDate / RtcWriteDate
000000r 2               
000000r 2               ; Cartridge / boot redirect vector:
000000r 2               BOOT_VECTOR         := $035B             ; 2 bytes — Boot redirect address (0=normal boot)
000000r 2                                                        ;   Set after KernalInit to redirect Reset flow
000000r 2                                                        ;   KernalInit zeroes this; write after init returns
000000r 2               FS_IO_ADDR          := $037F             ; 2 bytes — Load/save target address for FsLoadFileAddr / FsSaveFileAddr
000000r 2               FS_FILE_SIZE        := $034A             ; 2 bytes — File size in bytes (set by caller for FsSaveFileAddr; populated by FsLoadFileAddr)
000000r 2               
000000r 2               ; Program image handoff (v1.3):
000000r 2               PRG_IMAGE_END       := $038E             ; 2 bytes — End address of a program image placed at
000000r 2                                                        ;   PROGRAM_START by a loader running outside BASIC
000000r 2                                                        ;   (e.g. the Monitor's L command); 0 = none.
000000r 2                                                        ;   KernalInit zeroes it; BASIC consumes and re-zeroes it
000000r 2                                                        ;   on entry, so a stale value is never acted on twice.
000000r 2                                                        ;   A loader that drops a .prg at $0800 and then hands
000000r 2                                                        ;   off to BASIC should write the end address here so
000000r 2                                                        ;   the attached machine code survives LOAD/SAVE.
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 3: KEY MEMORY LOCATIONS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               INPUT_BUFFER        := $0200             ; $0200-$02FF — 256-byte ring buffer (keyboard/serial input)
000000r 2               PROGRAM_START       := $0800             ; User programs and BASIC programs load here
000000r 2               ;                                        ; Program space extends to $7FFF (30 KB)
000000r 2               MEMORY_TOP          := $8000             ; First address past usable RAM (IO space starts here)
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 4: KERNAL JUMP TABLE ($A000-$A0FF)
000000r 2               ; =============================================================================
000000r 2               ; All entry points are stable 3-byte JMP instructions.  Call via JSR.
000000r 2               ; Unimplemented slots return immediately (RTS).
000000r 2               
000000r 2               ; --- Character I/O ---
000000r 2               Chrout              := $A000             ; Output character (dispatched by IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Handles CR ($0D), LF ($0A), BS ($08), BEL ($07) in video mode
000000r 2               
000000r 2               Chrin               := $A003             ; Input character from buffer (non-blocking poll)
000000r 2                                                        ;   Out: A = character, C=1 if char available, C=0 if not
000000r 2                                                        ;   Caller must loop until C=1 for blocking behavior
000000r 2                                                        ;   Echoes character via Chrout
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               WriteBuffer         := $A006             ; Write byte to input ring buffer
000000r 2                                                        ;   In: A = byte to write
000000r 2                                                        ;   Modifies: X
000000r 2               
000000r 2               ReadBuffer          := $A009             ; Read byte from input ring buffer
000000r 2                                                        ;   Out: A = byte read
000000r 2                                                        ;   Modifies: X, A
000000r 2               
000000r 2               BufferSize          := $A00C             ; Get number of unread bytes in input buffer
000000r 2                                                        ;   Out: A = count
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- IO Mode ---
000000r 2               SetIOMode           := $A00F             ; Set IO_MODE
000000r 2                                                        ;   In: A = mode (bit 0: 0=video, 1=serial)
000000r 2               
000000r 2               GetIOMode           := $A012             ; Get IO_MODE
000000r 2                                                        ;   Out: A = current IO_MODE
000000r 2               
000000r 2               ; --- Video (TMS9918 / pico9918) ---
000000r 2               InitVideo           := $A015             ; Initialize TMS9918 (text mode, 40×24)
000000r 2                                                        ;   Writes the 8 mode registers, then reloads the
000000r 2                                                        ;   character set into the pattern table (VRAM $0800)
000000r 2                                                        ;   A program that switched the VDP to a graphics mode
000000r 2                                                        ;   can fully restore text mode with this one call
000000r 2                                                        ;   STR_PTR is used internally but saved and restored
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoClear          := $A018             ; Clear screen (fill with spaces), reset cursor to (0,0)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoPutChar        := $A01B             ; Write character at cursor position (no cursor advance)
000000r 2                                                        ;   In: A = character
000000r 2               
000000r 2               VideoSetCursor      := $A01E             ; Set cursor position
000000r 2                                                        ;   In: X = column (0-39), Y = row (0-23)
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoGetCursor      := $A021             ; Get cursor position
000000r 2                                                        ;   Out: X = column (0-39), Y = row (0-23)
000000r 2               
000000r 2               VideoScroll         := $A024             ; Scroll screen up one line, clear bottom row
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               VideoSetColor       := $A027             ; Set TMS9918 text color
000000r 2                                                        ;   In: A = color byte (high nibble = foreground, low nibble = background)
000000r 2                                                        ;   See TMS9918 Color Constants below
000000r 2                                                        ;   Skips silently if no video card is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               VideoChroutRaw      := $A02A             ; Output char to video with no control-code handling
000000r 2                                                        ;   In: A = character code (0-255)
000000r 2                                                        ;   Preserves: A, X, Y
000000r 2                                                        ;   Always renders glyph, never interprets CR/LF/BS/BEL
000000r 2               
000000r 2               ; --- Sound (SID / ARMSID) ---
000000r 2               InitSID             := $A02D             ; Initialize SID (clear all registers, volume=15)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               Beep                := $A030             ; Play short beep tone (~475 Hz)
000000r 2                                                        ;   Skips silently if no SID detected
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               SidPlayNote         := $A033             ; Play note on a SID voice
000000r 2                                                        ;   In: A = voice (0-2), X = freq low, Y = freq high
000000r 2                                                        ;   Uses triangle waveform, ADSR: A=0 D=9 S=F R=8
000000r 2                                                        ;   Full sustain holds the note flat until gated off
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSilence          := $A036             ; Silence all 3 SID voices (gate off only)
000000r 2                                                        ;   Frequencies are left intact — the envelope release
000000r 2                                                        ;   rings the tone out.  Zeroing freq would freeze the
000000r 2                                                        ;   waveform and decay a DC offset (audible thump)
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SidSetVolume        := $A039             ; Set SID master volume
000000r 2                                                        ;   In: A = volume (0-15); only the low nibble is used
000000r 2                                                        ;   Skips silently if no SID is fitted
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Filesystem (disk-banked, 16-file directory per disk) ---
000000r 2               ;   The CF card is divided into 256 disk banks of 1 MB each (FS_DISK_SECTORS
000000r 2               ;   sectors × 512 bytes).  CF_DISK ($030F) selects the active bank (reset to
000000r 2               ;   0 on boot).  Use FsSetDisk / FsGetDisk to change it at runtime.  Each
000000r 2               ;   bank has its own directory at the first sector, holding up to 16 entries
000000r 2               ;   (8.3 filenames, space-padded, case-insensitive).  All FS routines and
000000r 2               ;   StReadSector / StWriteSector operate on the selected bank automatically.
000000r 2               ;   Pass null-terminated "NAME.EXT" string via STR_PTR ($02-$03).
000000r 2               ;   Use FsLoadFileAddr / FsSaveFileAddr for load-to-address transfers.
000000r 2               ;   The extension is inert — nothing in the BIOS branches on it, so .PRG, .BAS
000000r 2               ;   and .FOO behave identically.  What a file means is decided by the routine
000000r 2               ;   that loads it, never by its name.
000000r 2               ;   All FS routines use $0600-$07FF as a 512-byte sector buffer.
000000r 2               
000000r 2               FsLoadFile          := $A03C             ; Load file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFile          := $A03F             ; Save file to CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsDeleteFile        := $A042             ; Delete file from CF
000000r 2                                                        ;   In: STR_PTR = pointer to null-terminated filename
000000r 2                                                        ;   Out: C=0 success, C=1 not found or error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Keyboard / GPIO ---
000000r 2               InitKB              := $A045             ; Initialize VIA for keyboard input
000000r 2                                                        ;   Configures Port A/B as inputs, enables CB1/CA1 IRQs
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               ; --- Joysticks ---
000000r 2               ;   Both ports are ACTIVE LOW — each line is pulled up through 1K and grounded
000000r 2               ;   by its switch — and both routines return the port read raw.  So a held
000000r 2               ;   button is a 0 bit and an untouched stick reads $FF:
000000r 2               ;
000000r 2               ;     Bit:  7   6   5   4   3   2   1   0
000000r 2               ;           R   L   D   U   Y   X   B   A
000000r 2               ;
000000r 2               ;   Test a direction with:  lda ... / and #%00010000 / beq @UpHeld
000000r 2               ;
000000r 2               ;   Neither routine checks HW_PRESENT — with no GPIO card fitted they read a
000000r 2               ;   floating bus and the value is meaningless.  Test HW_GPIO first if the card
000000r 2               ;   may be absent.  (BASIC's JOY() does this and reports $FF.)
000000r 2               ;
000000r 2               ;   Both routines release both encoders (KBDisable), read the port, then
000000r 2               ;   re-enable them (KBEnable).  The interrupt state is left alone.
000000r 2               
000000r 2               ReadJoystick1       := $A048             ; Read joystick 1 (VIA Port B)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ReadJoystick2       := $A04B             ; Read joystick 2 (VIA Port A)
000000r 2                                                        ;   Out: A = bitmask (active low, see above)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               ; --- Serial (R65C51) ---
000000r 2               InitSC              := $A04E             ; Initialize serial card (8-N-1, 19200 baud)
000000r 2                                                        ;   Modifies: A
000000r 2               
000000r 2               SerialChrout        := $A051             ; Direct serial output (bypasses IO_MODE)
000000r 2                                                        ;   In: A = character
000000r 2                                                        ;   Blocks until TX register is empty
000000r 2               
000000r 2               ; --- Serial Transfer ---
000000r 2               XModemLoad          := $A054             ; Receive data via XModem into memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = destination address
000000r 2                                                        ;   Out: C=0 success, XFER_PTR advanced past last byte written
000000r 2                                                        ;        XFER_REMAIN = total bytes received
000000r 2                                                        ;        C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               XModemSave          := $A057             ; Send data via XModem from memory
000000r 2                                                        ;   Protocol: standard XModem (128-byte blocks, checksum)
000000r 2                                                        ;   In: XFER_PTR = source address, XFER_REMAIN = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 transfer failed (timeout or CAN received)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- RTC (DS1511Y) ---
000000r 2               RtcReadTime         := $A05A             ; Read current time
000000r 2                                                        ;   Out: A = hours, X = minutes, Y = seconds (all binary)
000000r 2               
000000r 2               RtcReadDate         := $A05D             ; Read current date
000000r 2                                                        ;   Out: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) = century
000000r 2               
000000r 2               RtcWriteTime        := $A060             ; Set RTC time
000000r 2                                                        ;   In: A = hours, X = minutes, Y = seconds (all binary)
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcWriteDate        := $A063             ; Set RTC date
000000r 2                                                        ;   In: A = day, X = month, Y = year (all binary)
000000r 2                                                        ;   RTC_BUF_CENT ($030B) must hold century
000000r 2                                                        ;   Modifies: A, X
000000r 2               
000000r 2               RtcReadNVRAM        := $A066             ; Read byte from DS1511Y NVRAM (256 bytes)
000000r 2                                                        ;   In: X = address ($00-$FF)
000000r 2                                                        ;   Out: A = data byte
000000r 2               
000000r 2               RtcWriteNVRAM       := $A069             ; Write byte to DS1511Y NVRAM
000000r 2                                                        ;   In: X = address ($00-$FF), A = data byte
000000r 2               
000000r 2               ; --- CompactFlash Storage ---
000000r 2               StReadSector        := $A06C             ; Read one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = dest
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWriteSector       := $A06F             ; Write one 512-byte sector
000000r 2                                                        ;   In: CF_LBA ($26-$29) = LBA, CF_BUF_PTR ($24-$25) = source
000000r 2                                                        ;   Out: C=0 success, C=1 error; CF_BUF_PTR advanced by 512
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               StWaitReady         := $A072             ; Wait for CF to become ready (BSY=0, RDY=1)
000000r 2                                                        ;   Out: C=0 ready, C=1 timeout/error
000000r 2                                                        ;   Returns C=1 at once if the boot probe found no CF
000000r 2                                                        ;   card, rather than spinning out the full timeout.
000000r 2                                                        ;   Every FS and sector routine passes through here, so
000000r 2                                                        ;   an empty slot fails fast throughout the stack
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               ; --- Timing ---
000000r 2               SysDelay            := $A075             ; Delay for specified centiseconds (10 ms units)
000000r 2                                                        ;   In: A = low byte, X = high byte (16-bit count)
000000r 2                                                        ;   Uses VIA T1 if available, else software loop
000000r 2                                                        ;   Modifies: A, X, Y (X/Y clobbered only in software-fallback path)
000000r 2               
000000r 2               ; --- System / Cartridge Support ---
000000r 2               KernalInit          := $A078             ; Initialize all hardware (vectors, probe & init all I/O)
000000r 2                                                        ;   Caller MUST reset the stack pointer before JSR:
000000r 2                                                        ;     ldx #$ff / txs / jsr KernalInit
000000r 2                                                        ;   Zeroes BOOT_VECTOR, PRG_IMAGE_END and CF_DISK;
000000r 2                                                        ;   sets HW_PRESENT, IO_MODE, IRQ/BRK/NMI ptrs
000000r 2                                                        ;   Does NOT reset the stack pointer
000000r 2                                                        ;   Does NOT enable interrupts (caller must CLI)
000000r 2                                                        ;   Does NOT play beep, display splash, or enter boot menu
000000r 2                                                        ;   Does NOT halt if no console is detected
000000r 2                                                        ;   Modifies: All registers, flags
000000r 2               
000000r 2               KernalVersion       := $A07B             ; Get BIOS version
000000r 2                                                        ;   Out: A = major version, X = minor version
000000r 2               
000000r 2               ; --- Disk-banking & addressed storage (v1.1) ---
000000r 2               ;   CF_DISK ($030F) selects the current disk bank (0–255).
000000r 2               ;   All FS routines, StReadSector, and StWriteSector address the selected
000000r 2               ;   bank automatically.  Bank changes survive until the next reset.
000000r 2               
000000r 2               FsLoadFileAddr      := $A07E             ; Load named file from current disk to FS_IO_ADDR
000000r 2                                                        ;   In: STR_PTR = null-terminated filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = destination address
000000r 2                                                        ;   Out: C=0 success, FS_FILE_SIZE = bytes loaded; C=1 error
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSaveFileAddr      := $A081             ; Save FS_FILE_SIZE bytes from FS_IO_ADDR to a named file
000000r 2                                                        ;   In: STR_PTR = filename
000000r 2                                                        ;       FS_IO_ADDR ($037F) = source address
000000r 2                                                        ;       FS_FILE_SIZE ($034A) = byte count
000000r 2                                                        ;   Out: C=0 success, C=1 error (disk full or write error)
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsFormatDisk        := $A084             ; Zero the current disk's directory (erases all 16 entries)
000000r 2                                                        ;   Out: C=0 success, C=1 write error
000000r 2                                                        ;   No confirmation prompt — caller is responsible
000000r 2                                                        ;   Modifies: A, X, Y
000000r 2               
000000r 2               FsSetDisk           := $A087             ; Select the current CF disk bank
000000r 2                                                        ;   In: A = disk number (0–255) → stored in CF_DISK ($030F)
000000r 2                                                        ;   Modifies: Flags
000000r 2               
000000r 2               FsGetDisk           := $A08A             ; Get the current CF disk bank
000000r 2                                                        ;   Out: A = CF_DISK value (0–255)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               FsPrintDisk         := $A08D             ; Print "DISK n" + CRLF via Chrout (decimal, no leading zeros)
000000r 2                                                        ;   Uses current CF_DISK
000000r 2                                                        ;   Modifies: Flags, A, X, Y
000000r 2               
000000r 2               ; --- General Output Utilities (console routed by IO_MODE via Chrout) ---
000000r 2               PrintStr            := $A090             ; Print a NUL-terminated string
000000r 2                                                        ;   In : A = string addr low, Y = string addr high
000000r 2                                                        ;   Modifies: Flags, A, Y, STR_PTR (X preserved)
000000r 2               PrintCRLF           := $A093             ; Print CR ($0D) then LF ($0A)
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               PrintDecU16         := $A096             ; Print an unsigned 16-bit value as decimal
000000r 2                                                        ;   In : A = value low, X = value high (no leading zeros)
000000r 2                                                        ;   Modifies: Flags, A, X, Y, FS_FILE_SIZE, FS_DIR_IDX
000000r 2               
000000r 2               ; --- Keyboard Encoder Control (raw GPIO port access) ---
000000r 2               ;   Both keyboard encoders drive the VIA ports the joysticks share.  Disable
000000r 2               ;   them to read GPIO_PORTA/GPIO_PORTB directly, then re-enable them.  The
000000r 2               ;   ReadJoystick routines do this for you; call these only for custom reads.
000000r 2               KBDisable           := $A099             ; Release both encoders and wait for them to let go
000000r 2                                                        ;   Busy-waits ~200 us so the ports settle before reading
000000r 2                                                        ;   Safe to call while the caller owns the VIA timers
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               KBEnable            := $A09C             ; Re-enable both keyboard encoders
000000r 2                                                        ;   Modifies: Flags, A
000000r 2               
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 5: IO HARDWARE REGISTERS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Banked RAM Low (IO 1: $8000-$83FF) ---
000000r 2               ;   256 banks × ~1 KB each.  Write bank number to latch, then access data window.
000000r 2               RAM_DATA_L          := $8000             ; R/W data window ($8000-$83FE)
000000r 2               RAM_BANK_L          := $83FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- Banked RAM High (IO 2: $8400-$87FF) ---
000000r 2               RAM_DATA_H          := $8400             ; R/W data window ($8400-$87FE)
000000r 2               RAM_BANK_H          := $87FF             ; Write-only bank latch ($00-$FF)
000000r 2               
000000r 2               ; --- RTC (DS1511Y) (IO 3: $8800-$881F) ---
000000r 2               RTC_SEC             := $8800             ; Seconds      (BCD, 00-59)
000000r 2               RTC_MIN             := $8801             ; Minutes      (BCD, 00-59)
000000r 2               RTC_HR              := $8802             ; Hours        (BCD, 00-23, 24h mode)
000000r 2               RTC_DAY             := $8803             ; Day of week  (1-7)
000000r 2               RTC_DATE            := $8804             ; Day of month (BCD, 01-31)
000000r 2               RTC_MON             := $8805             ; Month        (BCD, 01-12)
000000r 2               RTC_YR              := $8806             ; Year         (BCD, 00-99)
000000r 2               RTC_CENT            := $8807             ; Century      (BCD, 00-39)
000000r 2               RTC_ALARM_SEC       := $8808             ; Alarm seconds
000000r 2               RTC_ALARM_MIN       := $8809             ; Alarm minutes
000000r 2               RTC_ALARM_HR        := $880A             ; Alarm hours
000000r 2               RTC_ALARM_DATE      := $880B             ; Alarm day of month
000000r 2               RTC_WD_L            := $880C             ; Watchdog low
000000r 2               RTC_WD_H            := $880D             ; Watchdog high
000000r 2               RTC_CTRL_A          := $880E             ; Control Register A
000000r 2               RTC_CTRL_B          := $880F             ; Control Register B
000000r 2               RTC_RAM_ADDR        := $8810             ; NVRAM address register
000000r 2               RTC_RAM_DATA        := $8813             ; NVRAM data register
000000r 2               ; Control Register B bits:
000000r 2               RTC_CTRL_B_TE       := %10000000         ; Transfer Enable — set to inhibit clock updates during write
000000r 2               ; Month register ($8805) — the upper 3 bits are oscillator/SQW control, not month data.
000000r 2               ; Always mask with RTC_MON_MASK when reading the month, and preserve these bits on write.
000000r 2               RTC_MON_MASK        := %00011111         ; Month value occupies the low 5 bits
000000r 2               RTC_MON_EOSC        := %10000000         ; Oscillator Start/Stop (0 = oscillator running)
000000r 2               RTC_MON_E32K        := %01000000         ; 32 kHz square-wave enable (1 = SQW output disabled)
000000r 2               RTC_MON_BB32        := %00100000         ; Battery-backup 32 kHz SQW enable (1 = enabled in backup)
000000r 2               
000000r 2               ; --- CompactFlash / Storage (IO 4: $8C00-$8C07) ---
000000r 2               ;   8-bit IDE (True IDE) mode.  The BIOS issues Set Features $01 at boot
000000r 2               ;   to enable 8-bit data transfers.
000000r 2               ST_DATA             := $8C00             ; R/W — Data register
000000r 2               ST_ERROR            := $8C01             ; Read — Error register
000000r 2               ST_FEATURE          := $8C01             ; Write — Feature register
000000r 2               ST_SECT_CNT         := $8C02             ; R/W — Sector count
000000r 2               ST_LBA_0            := $8C03             ; R/W — LBA bits 0-7
000000r 2               ST_LBA_1            := $8C04             ; R/W — LBA bits 8-15
000000r 2               ST_LBA_2            := $8C05             ; R/W — LBA bits 16-23
000000r 2               ST_LBA_3            := $8C06             ; R/W — LBA bits 24-27 + drive/mode
000000r 2               ST_STATUS           := $8C07             ; Read — Status register
000000r 2               ST_CMD              := $8C07             ; Write — Command register
000000r 2               
000000r 2               ; CF Status Register bits:
000000r 2               ST_STATUS_ERR       := %00000001         ; Error occurred
000000r 2               ST_STATUS_IDX       := %00000010         ; Index mark
000000r 2               ST_STATUS_CORR      := %00000100         ; Corrected data
000000r 2               ST_STATUS_DRQ       := %00001000         ; Data request — ready for data transfer
000000r 2               ST_STATUS_DSC       := %00010000         ; Drive seek complete
000000r 2               ST_STATUS_DWF       := %00100000         ; Drive write fault
000000r 2               ST_STATUS_RDY       := %01000000         ; Drive ready
000000r 2               ST_STATUS_BSY       := %10000000         ; Drive busy — all other bits invalid while set
000000r 2               
000000r 2               ; CF Error Register bits:
000000r 2               ST_ERR_AMNF         := %00000001         ; Address mark not found
000000r 2               ST_ERR_ABRT         := %00000100         ; Command aborted
000000r 2               ST_ERR_IDNF         := %00010000         ; ID not found
000000r 2               ST_ERR_UNC          := %01000000         ; Uncorrectable data error
000000r 2               ST_ERR_BBK          := %10000000         ; Bad block detected
000000r 2               
000000r 2               ; ATA Command bytes:
000000r 2               ST_CMD_READ         := $20               ; Read Sectors
000000r 2               ST_CMD_WRITE        := $30               ; Write Sectors
000000r 2               ST_CMD_SET_FEAT     := $EF               ; Set Features
000000r 2               ST_FEAT_8BIT        := $01               ; Feature: Enable 8-bit data I/O
000000r 2               ST_LBA3_MASTER      := $E0               ; LBA mode, master drive (bits 7-5=111, bit 4=0)
000000r 2               
000000r 2               ; Filesystem constants:
000000r 2               FS_DIR_LBA          = 0                  ; Directory sector at LBA 0
000000r 2               FS_DATA_START       = 1                  ; Data sectors start at LBA 1
000000r 2               FS_MAX_FILES        = 16                 ; Maximum directory entries
000000r 2               FS_ENTRY_SIZE       = 32                 ; Bytes per directory entry
000000r 2               FS_ENTRY_FLAGS      = 11                 ; Offset: flags byte within entry
000000r 2               FS_ENTRY_START      = 12                 ; Offset: start sector (2 bytes, little-endian)
000000r 2               FS_ENTRY_FSIZE      = 14                 ; Offset: file size (2 bytes, little-endian)
000000r 2               FS_FLAG_USED        = %00000001          ; Flags bit 0: entry in use
000000r 2               FS_DISK_SECTORS     = 2048               ; Sectors per disk bank (2048 × 512 bytes = 1 MB); 256 banks = 256 MB total
000000r 2               
000000r 2               ; XModem protocol constants (used with XModemLoad / XModemSave):
000000r 2               XMODEM_SOH          = $01                ; Start of Header
000000r 2               XMODEM_EOT          = $04                ; End of Transmission
000000r 2               XMODEM_ACK          = $06                ; Acknowledge
000000r 2               XMODEM_NAK          = $15                ; Negative Acknowledge (receiver sends to initiate transfer)
000000r 2               XMODEM_CAN          = $18                ; Cancel
000000r 2               XMODEM_SUB          = $1A                ; Padding byte (fills unused bytes in last block)
000000r 2               XMODEM_BLKSZ        = 128                ; Data bytes per block
000000r 2               XMODEM_MAXRETRY     = 10                 ; Max retries per block during transfer
000000r 2               XMODEM_STARTRETRY   = 60                 ; Retries waiting for initial connect (~60s)
000000r 2               
000000r 2               ; --- Serial Card (R65C51 ACIA) (IO 5: $9000-$9003) ---
000000r 2               ;   Default config after InitSC: 8-N-1, 19200 baud, RX IRQ enabled
000000r 2               SC_DATA             := $9000             ; R/W — Data register
000000r 2               SC_RESET            := $9001             ; Write — Programmatic reset (write any value)
000000r 2               SC_STATUS           := $9001             ; Read — Status register
000000r 2               SC_CMD              := $9002             ; R/W — Command register
000000r 2               SC_CTRL             := $9003             ; R/W — Control register
000000r 2               
000000r 2               ; Serial Status Register bits:
000000r 2               SC_STATUS_IRQ       := %10000000         ; Interrupt occurred
000000r 2               SC_STATUS_DSR       := %01000000         ; Data Set Ready
000000r 2               SC_STATUS_DCD       := %00100000         ; Data Carrier Detect
000000r 2               SC_STATUS_TDRE      := %00010000         ; TX Data Register Empty (ready to send)
000000r 2               SC_STATUS_RDRF      := %00001000         ; RX Data Register Full (byte available)
000000r 2               SC_STATUS_OVR       := %00000100         ; Overrun error
000000r 2               SC_STATUS_FRME      := %00000010         ; Framing error
000000r 2               SC_STATUS_PARE      := %00000001         ; Parity error
000000r 2               
000000r 2               ; --- GPIO / Input Board (65C22 VIA) (IO 6: $9400-$940F) ---
000000r 2               ;   Port B = matrix keyboard / joystick 1
000000r 2               ;   Port A = PS/2 keyboard / joystick 2
000000r 2               ;   CB1/CA1 IRQs fire when a key scancode is ready
000000r 2               GPIO_PORTB          := $9400             ; Port B data (active keyboard/joystick 1 data)
000000r 2               GPIO_PORTA          := $9401             ; Port A data (active keyboard/joystick 2 data)
000000r 2               GPIO_DDRB           := $9402             ; Port B data direction (0=input, 1=output per bit)
000000r 2               GPIO_DDRA           := $9403             ; Port A data direction
000000r 2               GPIO_T1CL           := $9404             ; Timer 1 counter low (read=counter, write=latch)
000000r 2               GPIO_T1CH           := $9405             ; Timer 1 counter high (write starts timer)
000000r 2               GPIO_T1LL           := $9406             ; Timer 1 latch low
000000r 2               GPIO_T1LH           := $9407             ; Timer 1 latch high
000000r 2               GPIO_T2CL           := $9408             ; Timer 2 counter low
000000r 2               GPIO_T2CH           := $9409             ; Timer 2 counter high
000000r 2               GPIO_SR             := $940A             ; Shift register
000000r 2               GPIO_ACR            := $940B             ; Auxiliary control register
000000r 2               GPIO_PCR            := $940C             ; Peripheral control register
000000r 2               GPIO_IFR            := $940D             ; Interrupt flag register
000000r 2               GPIO_IER            := $940E             ; Interrupt enable register
000000r 2               GPIO_ORA            := $940F             ; Port A (no handshake)
000000r 2               
000000r 2               ; VIA Peripheral Control Register (PCR) mode bits:
000000r 2               GPIO_PCR_CB2_LO     := %11000000         ; CB2 = manual output low  (enable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB2_HI     := %11100000         ; CB2 = manual output high (disable matrix keyboard encoder)
000000r 2               GPIO_PCR_CB1_NEG    := %00000000         ; CB1 = active on falling edge
000000r 2               GPIO_PCR_CA2_LO     := %00001100         ; CA2 = manual output low  (enable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA2_HI     := %00001110         ; CA2 = manual output high (disable PS/2 keyboard encoder)
000000r 2               GPIO_PCR_CA1_NEG    := %00000000         ; CA1 = active on falling edge
000000r 2               
000000r 2               ; VIA Interrupt flag/enable bits:
000000r 2               GPIO_INT_CB1        := %00010000         ; Bit 4: CB1 interrupt (matrix keyboard data ready)
000000r 2               GPIO_INT_CA1        := %00000010         ; Bit 1: CA1 interrupt (PS/2 keyboard data ready)
000000r 2               GPIO_IER_SET        := %10000000         ; IER bit 7: 1=set named bits, 0=clear named bits
000000r 2               
000000r 2               ; --- Sound Card (SID / ARMSID) (IO 7: $9800-$981C) ---
000000r 2               ;   MOS 6581/8580 compatible.  3 voices, each with independent frequency,
000000r 2               ;   pulse width, waveform, and ADSR envelope.  Global filter and volume.
000000r 2               
000000r 2               ; Voice 1:
000000r 2               SID_V1_FREQ_LO      := $9800             ; Frequency low byte
000000r 2               SID_V1_FREQ_HI      := $9801             ; Frequency high byte
000000r 2               SID_V1_PW_LO        := $9802             ; Pulse width low byte (bits 0-7)
000000r 2               SID_V1_PW_HI        := $9803             ; Pulse width high nibble (bits 0-3)
000000r 2               SID_V1_CTRL         := $9804             ; Control register (waveform + gate)
000000r 2               SID_V1_AD           := $9805             ; Attack (high nibble) / Decay (low nibble)
000000r 2               SID_V1_SR           := $9806             ; Sustain (high nibble) / Release (low nibble)
000000r 2               
000000r 2               ; Voice 2:
000000r 2               SID_V2_FREQ_LO      := $9807
000000r 2               SID_V2_FREQ_HI      := $9808
000000r 2               SID_V2_PW_LO        := $9809
000000r 2               SID_V2_PW_HI        := $980A
000000r 2               SID_V2_CTRL         := $980B
000000r 2               SID_V2_AD           := $980C
000000r 2               SID_V2_SR           := $980D
000000r 2               
000000r 2               ; Voice 3:
000000r 2               SID_V3_FREQ_LO      := $980E
000000r 2               SID_V3_FREQ_HI      := $980F
000000r 2               SID_V3_PW_LO        := $9810
000000r 2               SID_V3_PW_HI        := $9811
000000r 2               SID_V3_CTRL         := $9812
000000r 2               SID_V3_AD           := $9813
000000r 2               SID_V3_SR           := $9814
000000r 2               
000000r 2               ; Global SID registers:
000000r 2               SID_FC_LO           := $9815             ; Filter cutoff low (bits 0-2)
000000r 2               SID_FC_HI           := $9816             ; Filter cutoff high (bits 0-7)
000000r 2               SID_RES_FILT        := $9817             ; Resonance (high nibble) / Filter enable per voice (bits 0-2)
000000r 2               SID_MODE_VOL        := $9818             ; Filter mode (high nibble) / Master volume (low nibble, 0-15)
000000r 2               SID_PADDLE_X        := $9819             ; Paddle X (read-only)
000000r 2               SID_PADDLE_Y        := $981A             ; Paddle Y (read-only)
000000r 2               SID_OSC3            := $981B             ; Oscillator 3 output (read-only)
000000r 2               SID_ENV3            := $981C             ; Envelope 3 output (read-only)
000000r 2               
000000r 2               ; SID Voice Control Register bits (apply to SID_Vn_CTRL):
000000r 2               SID_CTRL_GATE       := %00000001         ; Gate: 1=start attack, 0=start release
000000r 2               SID_CTRL_SYNC       := %00000010         ; Hard sync with preceding voice
000000r 2               SID_CTRL_RING       := %00000100         ; Ring modulation with preceding voice
000000r 2               SID_CTRL_TEST       := %00001000         ; Test bit (resets oscillator)
000000r 2               SID_CTRL_TRIANGLE   := %00010000         ; Triangle waveform
000000r 2               SID_CTRL_SAWTOOTH   := %00100000         ; Sawtooth waveform
000000r 2               SID_CTRL_PULSE      := %01000000         ; Pulse waveform
000000r 2               SID_CTRL_NOISE      := %10000000         ; Noise waveform
000000r 2               
000000r 2               ; SID Filter Mode bits (high nibble of SID_MODE_VOL):
000000r 2               SID_FILT_LP         := %00010000         ; Low-pass filter
000000r 2               SID_FILT_BP         := %00100000         ; Band-pass filter
000000r 2               SID_FILT_HP         := %01000000         ; High-pass filter
000000r 2               SID_FILT_3OFF       := %10000000         ; Disconnect voice 3 from output
000000r 2               
000000r 2               ; --- SID Frequency Table (1 MHz clock, equal temperament) ---
000000r 2               ;   Freq register = round(Hz × 16777216 / 1000000)
000000r 2               ;   Covers octaves 2-7 (C2=65 Hz to B7=3951 Hz), all 12 chromatic notes.
000000r 2               ;   Sharps and flats are provided as aliases (e.g. SID_NOTE_CS4 = SID_NOTE_Db4).
000000r 2               ;   Use SidPlayNote: A=voice (0-2), X=freq low byte, Y=freq high byte.
000000r 2               ;   Example: ldx #<SID_NOTE_A4 / ldy #>SID_NOTE_A4
000000r 2               
000000r 2               ; Octave 2 (C2=65.41 Hz .. B2=123.47 Hz)
000000r 2               SID_NOTE_C2         = $0449              ; ~65 Hz
000000r 2               SID_NOTE_CS2        = $048B              ; ~69 Hz
000000r 2               SID_NOTE_Db2        = SID_NOTE_CS2
000000r 2               SID_NOTE_D2         = $04D0              ; ~73 Hz
000000r 2               SID_NOTE_DS2        = $0519              ; ~78 Hz
000000r 2               SID_NOTE_Eb2        = SID_NOTE_DS2
000000r 2               SID_NOTE_E2         = $0567              ; ~82 Hz
000000r 2               SID_NOTE_F2         = $05B9              ; ~87 Hz
000000r 2               SID_NOTE_FS2        = $0610              ; ~93 Hz
000000r 2               SID_NOTE_Gb2        = SID_NOTE_FS2
000000r 2               SID_NOTE_G2         = $066C              ; ~98 Hz
000000r 2               SID_NOTE_GS2        = $06CE              ; ~104 Hz
000000r 2               SID_NOTE_Ab2        = SID_NOTE_GS2
000000r 2               SID_NOTE_A2         = $0735              ; ~110 Hz
000000r 2               SID_NOTE_AS2        = $07A3              ; ~117 Hz
000000r 2               SID_NOTE_Bb2        = SID_NOTE_AS2
000000r 2               SID_NOTE_B2         = $0817              ; ~123 Hz
000000r 2               
000000r 2               ; Octave 3 (C3=130.81 Hz .. B3=246.94 Hz)
000000r 2               SID_NOTE_C3         = $0893              ; ~131 Hz
000000r 2               SID_NOTE_CS3        = $0915              ; ~139 Hz
000000r 2               SID_NOTE_Db3        = SID_NOTE_CS3
000000r 2               SID_NOTE_D3         = $099F              ; ~147 Hz
000000r 2               SID_NOTE_DS3        = $0A32              ; ~156 Hz
000000r 2               SID_NOTE_Eb3        = SID_NOTE_DS3
000000r 2               SID_NOTE_E3         = $0ACD              ; ~165 Hz
000000r 2               SID_NOTE_F3         = $0B72              ; ~175 Hz
000000r 2               SID_NOTE_FS3        = $0C20              ; ~185 Hz
000000r 2               SID_NOTE_Gb3        = SID_NOTE_FS3
000000r 2               SID_NOTE_G3         = $0CD8              ; ~196 Hz
000000r 2               SID_NOTE_GS3        = $0D9C              ; ~208 Hz
000000r 2               SID_NOTE_Ab3        = SID_NOTE_GS3
000000r 2               SID_NOTE_A3         = $0E6B              ; ~220 Hz
000000r 2               SID_NOTE_AS3        = $0F46              ; ~233 Hz
000000r 2               SID_NOTE_Bb3        = SID_NOTE_AS3
000000r 2               SID_NOTE_B3         = $102F              ; ~247 Hz
000000r 2               
000000r 2               ; Octave 4 (C4=261.63 Hz .. B4=493.88 Hz) — middle octave
000000r 2               SID_NOTE_C4         = $1125              ; ~262 Hz (Middle C)
000000r 2               SID_NOTE_CS4        = $122A              ; ~277 Hz
000000r 2               SID_NOTE_Db4        = SID_NOTE_CS4
000000r 2               SID_NOTE_D4         = $133F              ; ~294 Hz
000000r 2               SID_NOTE_DS4        = $1464              ; ~311 Hz
000000r 2               SID_NOTE_Eb4        = SID_NOTE_DS4
000000r 2               SID_NOTE_E4         = $159A              ; ~330 Hz
000000r 2               SID_NOTE_F4         = $16E3              ; ~349 Hz
000000r 2               SID_NOTE_FS4        = $183F              ; ~370 Hz
000000r 2               SID_NOTE_Gb4        = SID_NOTE_FS4
000000r 2               SID_NOTE_G4         = $19B1              ; ~392 Hz
000000r 2               SID_NOTE_GS4        = $1B38              ; ~415 Hz
000000r 2               SID_NOTE_Ab4        = SID_NOTE_GS4
000000r 2               SID_NOTE_A4         = $1CD6              ; ~440 Hz (Concert A)
000000r 2               SID_NOTE_AS4        = $1E8D              ; ~466 Hz
000000r 2               SID_NOTE_Bb4        = SID_NOTE_AS4
000000r 2               SID_NOTE_B4         = $205E              ; ~494 Hz
000000r 2               
000000r 2               ; Octave 5 (C5=523.25 Hz .. B5=987.77 Hz)
000000r 2               SID_NOTE_C5         = $224B              ; ~523 Hz
000000r 2               SID_NOTE_CS5        = $2455              ; ~554 Hz
000000r 2               SID_NOTE_Db5        = SID_NOTE_CS5
000000r 2               SID_NOTE_D5         = $267E              ; ~587 Hz
000000r 2               SID_NOTE_DS5        = $28C8              ; ~622 Hz
000000r 2               SID_NOTE_Eb5        = SID_NOTE_DS5
000000r 2               SID_NOTE_E5         = $2B34              ; ~659 Hz
000000r 2               SID_NOTE_F5         = $2DC6              ; ~698 Hz
000000r 2               SID_NOTE_FS5        = $307F              ; ~740 Hz
000000r 2               SID_NOTE_Gb5        = SID_NOTE_FS5
000000r 2               SID_NOTE_G5         = $3361              ; ~784 Hz
000000r 2               SID_NOTE_GS5        = $366F              ; ~831 Hz
000000r 2               SID_NOTE_Ab5        = SID_NOTE_GS5
000000r 2               SID_NOTE_A5         = $39AC              ; ~880 Hz
000000r 2               SID_NOTE_AS5        = $3D1A              ; ~932 Hz
000000r 2               SID_NOTE_Bb5        = SID_NOTE_AS5
000000r 2               SID_NOTE_B5         = $40BC              ; ~988 Hz
000000r 2               
000000r 2               ; Octave 6 (C6=1046.50 Hz .. B6=1975.53 Hz)
000000r 2               SID_NOTE_C6         = $4495              ; ~1047 Hz
000000r 2               SID_NOTE_CS6        = $48A9              ; ~1109 Hz
000000r 2               SID_NOTE_Db6        = SID_NOTE_CS6
000000r 2               SID_NOTE_D6         = $4CFC              ; ~1175 Hz
000000r 2               SID_NOTE_DS6        = $518F              ; ~1245 Hz
000000r 2               SID_NOTE_Eb6        = SID_NOTE_DS6
000000r 2               SID_NOTE_E6         = $5669              ; ~1319 Hz
000000r 2               SID_NOTE_F6         = $5B8C              ; ~1397 Hz
000000r 2               SID_NOTE_FS6        = $60FE              ; ~1480 Hz
000000r 2               SID_NOTE_Gb6        = SID_NOTE_FS6
000000r 2               SID_NOTE_G6         = $66C2              ; ~1568 Hz
000000r 2               SID_NOTE_GS6        = $6CDF              ; ~1661 Hz
000000r 2               SID_NOTE_Ab6        = SID_NOTE_GS6
000000r 2               SID_NOTE_A6         = $7358              ; ~1760 Hz
000000r 2               SID_NOTE_AS6        = $7A34              ; ~1865 Hz
000000r 2               SID_NOTE_Bb6        = SID_NOTE_AS6
000000r 2               SID_NOTE_B6         = $8178              ; ~1976 Hz
000000r 2               
000000r 2               ; Octave 7 (C7=2093.00 Hz .. A7=3520.00 Hz; B7 overflows 16-bit register)
000000r 2               SID_NOTE_C7         = $892B              ; ~2093 Hz
000000r 2               SID_NOTE_CS7        = $9153              ; ~2217 Hz
000000r 2               SID_NOTE_Db7        = SID_NOTE_CS7
000000r 2               SID_NOTE_D7         = $99F7              ; ~2349 Hz
000000r 2               SID_NOTE_DS7        = $A31F              ; ~2489 Hz
000000r 2               SID_NOTE_Eb7        = SID_NOTE_DS7
000000r 2               SID_NOTE_E7         = $ACD2              ; ~2637 Hz
000000r 2               SID_NOTE_F7         = $B719              ; ~2794 Hz
000000r 2               SID_NOTE_FS7        = $C1FC              ; ~2960 Hz
000000r 2               SID_NOTE_Gb7        = SID_NOTE_FS7
000000r 2               SID_NOTE_G7         = $CD85              ; ~3136 Hz
000000r 2               SID_NOTE_GS7        = $D9BD              ; ~3322 Hz
000000r 2               SID_NOTE_Ab7        = SID_NOTE_GS7
000000r 2               SID_NOTE_A7         = $E6B0              ; ~3520 Hz
000000r 2               SID_NOTE_AS7        = $F467              ; ~3729 Hz
000000r 2               SID_NOTE_Bb7        = SID_NOTE_AS7
000000r 2               ; Note: B7 (~3951 Hz = $102F0) exceeds the 16-bit SID register — not defined
000000r 2               
000000r 2               ; --- Video Card (TMS9918 / pico9918) (IO 8: $9C00-$9C01) ---
000000r 2               ;   Text mode: 40 columns × 24 rows.  Name table at VRAM $0000 (960 bytes).
000000r 2               ;   Pattern table at VRAM $0800 (2 KB, 256 × 8-byte character patterns).
000000r 2               ;   To write to a VRAM address: write low byte to VC_REG, then (high | $40) to VC_REG.
000000r 2               ;   To read from a VRAM address: write low byte to VC_REG, then high byte to VC_REG.
000000r 2               ;   Register writes: write data byte to VC_REG, then (reg# | $80) to VC_REG.
000000r 2               VC_DATA             := $9C00             ; R/W — VRAM data (auto-increments address)
000000r 2               VC_REG              := $9C01             ; Write — Address/register port
000000r 2               VC_STATUS           := $9C01             ; Read — Status register
000000r 2               
000000r 2               ; =============================================================================
000000r 2               ;   SECTION 6: USEFUL CONSTANTS
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- BIOS Version ---
000000r 2               BIOS_VERSION_MAJOR  = 1
000000r 2               BIOS_VERSION_MINOR  = 5
000000r 2               
000000r 2               ; --- ASCII Control Characters ---
000000r 2               CHAR_BEL            = $07                ; Bell (Beep via SID)
000000r 2               CHAR_BS             = $08                ; Backspace (cursor left + erase in video mode)
000000r 2               CHAR_LF             = $0A                ; Line Feed (cursor down, scroll if at bottom)
000000r 2               CHAR_CR             = $0D                ; Carriage Return (cursor to column 0)
000000r 2               CHAR_ESC            = $1B                ; Escape
000000r 2               CHAR_SPACE          = $20                ; Space
000000r 2               
000000r 2               ; --- Video Dimensions ---
000000r 2               VID_COLS            = 40                 ; Screen width in columns
000000r 2               VID_ROWS            = 24                 ; Screen height in rows
000000r 2               VID_NAME_TABLE      = $0000              ; VRAM address of name table (40×24 = 960 bytes)
000000r 2               VID_PATTERN_TABLE   = $0800              ; VRAM address of pattern/character table (2048 bytes)
000000r 2               
000000r 2               ; --- TMS9918 Color Constants (for VideoSetColor) ---
000000r 2               ;   Pass as: (foreground << 4) | background
000000r 2               ;   Example: white on black = $F0, green on black = $20
000000r 2               TMS_TRANSPARENT     = $0
000000r 2               TMS_BLACK           = $1
000000r 2               TMS_MED_GREEN       = $2
000000r 2               TMS_LT_GREEN        = $3
000000r 2               TMS_DK_BLUE         = $4
000000r 2               TMS_LT_BLUE         = $5
000000r 2               TMS_DK_RED          = $6
000000r 2               TMS_CYAN            = $7
000000r 2               TMS_MED_RED         = $8
000000r 2               TMS_LT_RED          = $9
000000r 2               TMS_DK_YELLOW       = $A
000000r 2               TMS_LT_YELLOW       = $B
000000r 2               TMS_DK_GREEN        = $C
000000r 2               TMS_MAGENTA         = $D
000000r 2               TMS_GRAY            = $E
000000r 2               TMS_WHITE           = $F
000000r 2               
000000r 2               ; --- Monitor Entry Points ---
000000r 2               ;   The machine code monitor lives at $EE00 and is entered normally via BRK.
000000r 2               ;   These are useful if you want to jump there directly.
000000r 2               MONITOR_ENTRY       := $EE00             ; Cold entry (from boot menu or user code)
000000r 2               MONITOR_BRK_ENTRY   := $EE03             ; BRK entry (displays saved registers)
000000r 2               
000000r 1               .include "src/zeropage.inc"
000000r 2               ; =============================================================================
000000r 2               ;   zeropage.inc — Snake zero-page variables, RAM arrays, and game constants
000000r 2               ; =============================================================================
000000r 2               ;   Zero page $3A-$FF is free for a program that has taken the machine over
000000r 2               ;   (see SECTION 1 of 6502.inc). A cartridge never runs BASIC/Monitor/XModem,
000000r 2               ;   so $0800+ RAM (normally program space) is also free for our arrays.
000000r 2               ;
000000r 2               ;   6502.cfg defines no RAM/BSS segment, so every variable below is a fixed-
000000r 2               ;   address equate (:=), not a .zeropage/.bss allocation.
000000r 2               ; =============================================================================
000000r 2               
000000r 2               ; --- Game state constants ---
000000r 2               STATE_TITLE     = 0
000000r 2               STATE_PLAYING   = 1
000000r 2               STATE_GAMEOVER  = 2
000000r 2               STATE_PAUSED    = 3
000000r 2               
000000r 2               DIR_UP          = 0
000000r 2               DIR_DOWN        = 1
000000r 2               DIR_LEFT        = 2
000000r 2               DIR_RIGHT       = 3
000000r 2               
000000r 2               ; --- Zero page variables ---
000000r 2               GAME_STATE      := $3A   ; STATE_TITLE / STATE_PLAYING / STATE_GAMEOVER
000000r 2               DIRECTION       := $3B   ; current heading (DIR_*)
000000r 2               NEXT_DIR        := $3C   ; buffered heading, applied next tick if not a reversal
000000r 2               HEAD_X          := $3D   ; current head column
000000r 2               HEAD_Y          := $3E   ; current head row
000000r 2               HEAD_IDX        := $3F   ; ring-buffer index of newest segment
000000r 2               TAIL_IDX        := $40   ; ring-buffer index of oldest segment
000000r 2               SNAKE_LEN       := $41   ; current length
000000r 2               FOOD_X          := $42
000000r 2               FOOD_Y          := $43
000000r 2               SCORE_LO        := $44   ; binary score, 16-bit
000000r 2               SCORE_HI        := $45
000000r 2               RNG_STATE       := $46   ; 8-bit LFSR state (never 0)
000000r 2               NEW_HEAD_X      := $47   ; scratch: candidate head position this tick
000000r 2               NEW_HEAD_Y      := $48
000000r 2               GROW_FLAG       := $49   ; nonzero if candidate head lands on food this tick
000000r 2               OFFSET_LO       := $4A   ; scratch: row*32+col offset (VRAM name-table / occupancy index)
000000r 2               OFFSET_HI       := $4B
000000r 2               RETRY_CNT       := $4C   ; bounded retry counter for food respawn
000000r 2               SCAN_TMP        := $4D   ; scratch loop counter (used by init/drawing loops)
000000r 2               DIGIT_BUF       := $4E   ; 5 bytes, $4E-$52: ASCII decimal digits of score
000000r 2               LAST_KEY        := $53   ; unused scratch (reserved)
000000r 2               JOY_STATE       := $54   ; last raw ReadJoystick1 byte
000000r 2               KB_CHAR         := $55   ; last Chrin byte
000000r 2               WORK_PTR        := $56   ; 2 bytes, $56-$57: general-purpose indirect pointer
000000r 2               OLD_TAIL_X      := $58   ; scratch: tail cell about to be vacated this tick
000000r 2               OLD_TAIL_Y      := $59
000000r 2               STR_IDX         := $5A   ; scratch: string/loop index for text-drawing routines
000000r 2               SC_TMP_LO       := $5B   ; scratch: working copy of score during digit conversion
000000r 2               SC_TMP_HI       := $5C
000000r 2               SUB_LO          := $5D   ; scratch: subtrahend for decimal digit conversion
000000r 2               SUB_HI          := $5E
000000r 2               DIGIT_COUNT     := $5F   ; scratch: digit accumulator during conversion
000000r 2               START_PRESSED   := $60   ; set by PollInput when fire/space is down this poll
000000r 2               PREV_FIRE       := $61   ; START_PRESSED as of the previous poll (edge detection)
000000r 2               FIRE_EDGE       := $62   ; set only on the poll fire/space first goes down —
000000r 2                                         ; use this (not START_PRESSED) for state transitions,
000000r 2                                         ; so holding the button doesn't repeatedly re-trigger
000000r 2                                         ; pause/resume/restart every tick it stays held
000000r 2               MSG_ROW         := $63   ; scratch: row argument for DrawString/ClearRow/DrawDigitBuf
000000r 2               SCAN_TMP2       := $64   ; scratch: second loop counter for nested row/col loops
000000r 2               HIGH_SCORE_LO   := $65   ; best score this power-on session (persisted to RTC
000000r 2               HIGH_SCORE_HI   := $66   ; NVRAM when that card is fitted; session-only otherwise)
000000r 2               NEW_HIGH_FLAG   := $67   ; set by GameOver when this round beat HIGH_SCORE
000000r 2               
000000r 2               ; --- RAM arrays (outside zero page; a cartridge never uses BASIC/PRG/CF RAM) ---
000000r 2               SEGMENTS_X      := $0800   ; 256 bytes — ring buffer of segment columns
000000r 2               SEGMENTS_Y      := $0900   ; 256 bytes — ring buffer of segment rows
000000r 2               OCCUPANCY       := $0A00   ; 768 bytes — 32x24 grid, row*32+col: 0=empty 1=snake 3=wall
000000r 2               
000000r 1               
000000r 1               .segment "CART"
000000r 1               
000000r 1               .include "src/tiles.asm"
000000r 2               ; =============================================================================
000000r 2               ;   tiles.asm — Graphics I playfield constants and custom 8x8 tile patterns
000000r 2               ; =============================================================================
000000r 2               
000000r 2               GRID_COLS       = 32
000000r 2               GRID_ROWS       = 24
000000r 2               
000000r 2               ; Playable interior bounds (row 0 = HUD, row 1/22 = border, row 23 = messages)
000000r 2               FIELD_LEFT      = 1
000000r 2               FIELD_RIGHT     = 30
000000r 2               FIELD_TOP       = 2
000000r 2               FIELD_BOTTOM    = 21
000000r 2               
000000r 2               ; Tile codes — each in its own color group (group = code>>3) so it gets an
000000r 2               ; independent fg/bg pair without disturbing the CP437 text glyphs used by
000000r 2               ; the HUD and messages (groups 4-11 for space/digits/uppercase letters).
000000r 2               TILE_BLANK      = $20    ; reused CP437 space glyph — untouched
000000r 2               TILE_HEAD       = $80    ; color group 16
000000r 2               TILE_BODY       = $88    ; color group 17
000000r 2               TILE_FOOD       = $90    ; color group 18
000000r 2               TILE_WALL       = $98    ; color group 19
000000r 2               TILE_FRAME      = $A0    ; color group 20 — game-over overlay box border
000000r 2               
000000r 2               COLOR_HEAD      = (TMS_LT_GREEN  << 4) | TMS_BLACK
000000r 2               COLOR_BODY      = (TMS_MED_GREEN << 4) | TMS_BLACK
000000r 2               COLOR_FOOD      = (TMS_MED_RED   << 4) | TMS_BLACK
000000r 2               COLOR_WALL      = (TMS_GRAY      << 4) | TMS_DK_BLUE
000000r 2               COLOR_FRAME     = (TMS_LT_YELLOW << 4) | TMS_LT_YELLOW
000000r 2               COLOR_TEXT      = (TMS_WHITE     << 4) | TMS_BLACK   ; default fill for all other groups
000000r 2               
000000r 2               ; Pattern-table destinations ($0800 base + code*8, per InitVideo's font load)
000000r 2               PATTERN_BASE    = $0800
000000r 2               PAT_HEAD_ADDR   = PATTERN_BASE + (TILE_HEAD*8)
000000r 2               PAT_BODY_ADDR   = PATTERN_BASE + (TILE_BODY*8)
000000r 2               PAT_FOOD_ADDR   = PATTERN_BASE + (TILE_FOOD*8)
000000r 2               PAT_WALL_ADDR   = PATTERN_BASE + (TILE_WALL*8)
000000r 2               PAT_FRAME_ADDR  = PATTERN_BASE + (TILE_FRAME*8)
000000r 2               
000000r 2               ; Game-over overlay box geometry (screen is 32x24; playfield rows 2-21)
000000r 2               BOX_LEFT        = 6
000000r 2               BOX_TOP         = 8
000000r 2               BOX_WIDTH       = 20
000000r 2               BOX_HEIGHT      = 8
000000r 2               
000000r 2               .segment "CART"
000000r 2               
000000r 2               ; 8x8 bitmaps, MSB = leftmost pixel, 1 = ink
000000r 2               
000000r 2               TileHeadData:
000000r 2  3C             .byte %00111100
000001r 2  7E             .byte %01111110
000002r 2  DB             .byte %11011011      ; eye dots punched into the blob
000003r 2  FF             .byte %11111111
000004r 2  FF             .byte %11111111
000005r 2  FF             .byte %11111111
000006r 2  7E             .byte %01111110
000007r 2  3C             .byte %00111100
000008r 2               
000008r 2               TileBodyData:
000008r 2  3C             .byte %00111100
000009r 2  7E             .byte %01111110
00000Ar 2  FF             .byte %11111111
00000Br 2  FF             .byte %11111111
00000Cr 2  FF             .byte %11111111
00000Dr 2  FF             .byte %11111111
00000Er 2  7E             .byte %01111110
00000Fr 2  3C             .byte %00111100
000010r 2               
000010r 2               TileFoodData:
000010r 2  18             .byte %00011000
000011r 2  3C             .byte %00111100
000012r 2  7E             .byte %01111110
000013r 2  FF             .byte %11111111
000014r 2  FF             .byte %11111111
000015r 2  7E             .byte %01111110
000016r 2  3C             .byte %00111100
000017r 2  18             .byte %00011000
000018r 2               
000018r 2               TileWallData:
000018r 2  FF             .byte %11111111
000019r 2  FF             .byte %11111111
00001Ar 2  FF             .byte %11111111
00001Br 2  FF             .byte %11111111
00001Cr 2  FF             .byte %11111111
00001Dr 2  FF             .byte %11111111
00001Er 2  FF             .byte %11111111
00001Fr 2  FF             .byte %11111111
000020r 2               
000020r 2               TileFrameData:
000020r 2  FF             .byte %11111111
000021r 2  FF             .byte %11111111
000022r 2  FF             .byte %11111111
000023r 2  FF             .byte %11111111
000024r 2  FF             .byte %11111111
000025r 2  FF             .byte %11111111
000026r 2  FF             .byte %11111111
000027r 2  FF             .byte %11111111
000028r 2               
000028r 1               .include "src/vdp.asm"
000028r 2               ; =============================================================================
000028r 2               ;   vdp.asm — TMS9918 Graphics I mode setup and drawing primitives
000028r 2               ; =============================================================================
000028r 2               ;   Port protocol (from 6502.inc, verified against the live BIOS source):
000028r 2               ;     Set VRAM write address: addr_lo -> VC_REG, then (addr_hi | $40) -> VC_REG
000028r 2               ;     Write a VDP register:   data    -> VC_REG, then (reg#   | $80) -> VC_REG
000028r 2               ; =============================================================================
000028r 2               
000028r 2               .segment "CART"
000028r 2               
000028r 2               ; -----------------------------------------------------------------------------
000028r 2               ; VdpWriteReg — write one VDP mode register
000028r 2               ; In: A = value, X = register number (0-7)
000028r 2               ;
000028r 2               ; The two writes below must land back-to-back with nothing else touching
000028r 2               ; VC_REG/VC_STATUS in between, or the chip's write-stage latch (which byte
000028r 2               ; is expected next) gets out of sync with ours. The VDP itself is an IRQ
000028r 2               ; source, and reading its status port (the same address as VC_REG) resets
000028r 2               ; that latch — so an interrupt landing between these two writes desyncs
000028r 2               ; every VDP write that follows, not just this one. PHP/SEI/PLP (not raw
000028r 2               ; SEI/CLI) so this composes correctly when called from an already-atomic
000028r 2               ; caller like DrawTile below.
000028r 2               ; -----------------------------------------------------------------------------
000028r 2               VdpWriteReg:
000028r 2  08             php
000029r 2  78             sei
00002Ar 2  8D 01 9C       sta VC_REG
00002Dr 2  8A             txa
00002Er 2  09 80          ora #$80
000030r 2  8D 01 9C       sta VC_REG
000033r 2  28             plp
000034r 2  60             rts
000035r 2               
000035r 2               ; -----------------------------------------------------------------------------
000035r 2               ; VdpSetAddr — set the VRAM read/write pointer
000035r 2               ; In: A = address low byte, X = address high byte
000035r 2               ; See the interrupt-safety note on VdpWriteReg above — same latch, same risk.
000035r 2               ; -----------------------------------------------------------------------------
000035r 2               VdpSetAddr:
000035r 2  08             php
000036r 2  78             sei
000037r 2  8D 01 9C       sta VC_REG
00003Ar 2  8A             txa
00003Br 2  09 40          ora #$40
00003Dr 2  8D 01 9C       sta VC_REG
000040r 2  28             plp
000041r 2  60             rts
000042r 2               
000042r 2               ; -----------------------------------------------------------------------------
000042r 2               ; ComputeOffset — compute row*32+col into OFFSET_LO/OFFSET_HI
000042r 2               ; In: A = row (0-23), X = col (0-31)
000042r 2               ; Clobbers: A, Y
000042r 2               ; -----------------------------------------------------------------------------
000042r 2               ComputeOffset:
000042r 2  85 4A          sta OFFSET_LO
000044r 2  64 4B          stz OFFSET_HI
000046r 2  A0 05          ldy #5
000048r 2               @shift:
000048r 2  06 4A          asl OFFSET_LO
00004Ar 2  26 4B          rol OFFSET_HI
00004Cr 2  88             dey
00004Dr 2  D0 F9          bne @shift
00004Fr 2  8A             txa
000050r 2  18             clc
000051r 2  65 4A          adc OFFSET_LO
000053r 2  85 4A          sta OFFSET_LO
000055r 2  90 02          bcc @done
000057r 2  E6 4B          inc OFFSET_HI
000059r 2               @done:
000059r 2  60             rts
00005Ar 2               
00005Ar 2               ; -----------------------------------------------------------------------------
00005Ar 2               ; VdpSetOffsetAddr — point the VRAM write pointer at name-table offset
00005Ar 2               ; OFFSET_LO/OFFSET_HI (name table base is $0000, so address == offset)
00005Ar 2               ; -----------------------------------------------------------------------------
00005Ar 2               VdpSetOffsetAddr:
00005Ar 2  A5 4A          lda OFFSET_LO
00005Cr 2  A6 4B          ldx OFFSET_HI
00005Er 2  4C rr rr       jmp VdpSetAddr        ; tail call — VdpSetAddr's rts returns to our caller
000061r 2               
000061r 2               ; -----------------------------------------------------------------------------
000061r 2               ; DrawTile — draw a tile code into the name table at (row,col)
000061r 2               ; In: A = row, X = col, Y = tile code
000061r 2               ;
000061r 2               ; Also atomic end-to-end (not just the address-set half): an interrupt
000061r 2               ; landing between the address-set and the data write is only harmless if
000061r 2               ; nothing else touches the VDP in between, which we can't assume — same
000061r 2               ; reasoning as VdpWriteReg above.
000061r 2               ; -----------------------------------------------------------------------------
000061r 2               DrawTile:
000061r 2  08             php
000062r 2  78             sei
000063r 2  5A             phy
000064r 2  20 rr rr       jsr ComputeOffset
000067r 2  20 rr rr       jsr VdpSetOffsetAddr
00006Ar 2  7A             ply
00006Br 2  98             tya
00006Cr 2  8D 00 9C       sta VC_DATA
00006Fr 2  28             plp
000070r 2  60             rts
000071r 2               
000071r 2               ; -----------------------------------------------------------------------------
000071r 2               ; EraseTile — draw TILE_BLANK at (row,col)
000071r 2               ; In: A = row, X = col
000071r 2               ; -----------------------------------------------------------------------------
000071r 2               EraseTile:
000071r 2  A0 20          ldy #TILE_BLANK
000073r 2  4C rr rr       jmp DrawTile
000076r 2               
000076r 2               ; -----------------------------------------------------------------------------
000076r 2               ; OccupancyPtr — point WORK_PTR at OCCUPANCY[row*32+col]
000076r 2               ; In: A = row, X = col  (OCCUPANCY is page-aligned, so only the high byte
000076r 2               ; needs the addition)
000076r 2               ; -----------------------------------------------------------------------------
000076r 2               OccupancyPtr:
000076r 2  20 rr rr       jsr ComputeOffset
000079r 2  A5 4B          lda OFFSET_HI
00007Br 2  18             clc
00007Cr 2  69 0A          adc #>OCCUPANCY
00007Er 2  85 57          sta WORK_PTR+1
000080r 2  A5 4A          lda OFFSET_LO
000082r 2  85 56          sta WORK_PTR
000084r 2  60             rts
000085r 2               
000085r 2               ; -----------------------------------------------------------------------------
000085r 2               ; OccupancySet — write a value into OCCUPANCY[row,col]
000085r 2               ; In: A = row, X = col, Y = value
000085r 2               ; -----------------------------------------------------------------------------
000085r 2               OccupancySet:
000085r 2  5A             phy
000086r 2  20 rr rr       jsr OccupancyPtr
000089r 2  7A             ply
00008Ar 2  98             tya
00008Br 2  A0 00          ldy #0
00008Dr 2  91 56          sta (WORK_PTR),y
00008Fr 2  60             rts
000090r 2               
000090r 2               ; -----------------------------------------------------------------------------
000090r 2               ; OccupancyGet — read OCCUPANCY[row,col]
000090r 2               ; In: A = row, X = col
000090r 2               ; Out: A = value
000090r 2               ; -----------------------------------------------------------------------------
000090r 2               OccupancyGet:
000090r 2  20 rr rr       jsr OccupancyPtr
000093r 2  A0 00          ldy #0
000095r 2  B1 56          lda (WORK_PTR),y
000097r 2  60             rts
000098r 2               
000098r 2               ; -----------------------------------------------------------------------------
000098r 2               ; InitOccupancy — clear the whole 768-byte occupancy grid to 0
000098r 2               ; -----------------------------------------------------------------------------
000098r 2               InitOccupancy:
000098r 2  A9 00          lda #<OCCUPANCY
00009Ar 2  85 56          sta WORK_PTR
00009Cr 2  A9 0A          lda #>OCCUPANCY
00009Er 2  85 57          sta WORK_PTR+1
0000A0r 2  A2 03          ldx #3
0000A2r 2  A9 00          lda #0
0000A4r 2               @pageLoop:
0000A4r 2  A0 00          ldy #0
0000A6r 2               @byteLoop:
0000A6r 2  91 56          sta (WORK_PTR),y
0000A8r 2  C8             iny
0000A9r 2  D0 FB          bne @byteLoop
0000ABr 2  E6 57          inc WORK_PTR+1
0000ADr 2  CA             dex
0000AEr 2  D0 F4          bne @pageLoop
0000B0r 2  60             rts
0000B1r 2               
0000B1r 2               ; -----------------------------------------------------------------------------
0000B1r 2               ; DrawBorder — draw the wall tile around the playfield, both visually and
0000B1r 2               ; in the OCCUPANCY grid (top/bottom rows across all columns, then the two
0000B1r 2               ; side columns for the interior rows).
0000B1r 2               ; -----------------------------------------------------------------------------
0000B1r 2               DrawBorder:
0000B1r 2  64 4D          stz SCAN_TMP
0000B3r 2               @topBottom:
0000B3r 2  A9 01          lda #(FIELD_TOP-1)
0000B5r 2  A6 4D          ldx SCAN_TMP
0000B7r 2  A0 98          ldy #TILE_WALL
0000B9r 2  20 rr rr       jsr DrawTile
0000BCr 2  A9 01          lda #(FIELD_TOP-1)
0000BEr 2  A6 4D          ldx SCAN_TMP
0000C0r 2  A0 03          ldy #3
0000C2r 2  20 rr rr       jsr OccupancySet
0000C5r 2               
0000C5r 2  A9 16          lda #(FIELD_BOTTOM+1)
0000C7r 2  A6 4D          ldx SCAN_TMP
0000C9r 2  A0 98          ldy #TILE_WALL
0000CBr 2  20 rr rr       jsr DrawTile
0000CEr 2  A9 16          lda #(FIELD_BOTTOM+1)
0000D0r 2  A6 4D          ldx SCAN_TMP
0000D2r 2  A0 03          ldy #3
0000D4r 2  20 rr rr       jsr OccupancySet
0000D7r 2               
0000D7r 2  E6 4D          inc SCAN_TMP
0000D9r 2  A5 4D          lda SCAN_TMP
0000DBr 2  C9 20          cmp #GRID_COLS
0000DDr 2  D0 D4          bne @topBottom
0000DFr 2               
0000DFr 2  A9 02          lda #FIELD_TOP
0000E1r 2  85 4D          sta SCAN_TMP
0000E3r 2               @sides:
0000E3r 2  A5 4D          lda SCAN_TMP
0000E5r 2  A2 00          ldx #(FIELD_LEFT-1)
0000E7r 2  A0 98          ldy #TILE_WALL
0000E9r 2  20 rr rr       jsr DrawTile
0000ECr 2  A5 4D          lda SCAN_TMP
0000EEr 2  A2 00          ldx #(FIELD_LEFT-1)
0000F0r 2  A0 03          ldy #3
0000F2r 2  20 rr rr       jsr OccupancySet
0000F5r 2               
0000F5r 2  A5 4D          lda SCAN_TMP
0000F7r 2  A2 1F          ldx #(FIELD_RIGHT+1)
0000F9r 2  A0 98          ldy #TILE_WALL
0000FBr 2  20 rr rr       jsr DrawTile
0000FEr 2  A5 4D          lda SCAN_TMP
000100r 2  A2 1F          ldx #(FIELD_RIGHT+1)
000102r 2  A0 03          ldy #3
000104r 2  20 rr rr       jsr OccupancySet
000107r 2               
000107r 2  E6 4D          inc SCAN_TMP
000109r 2  A5 4D          lda SCAN_TMP
00010Br 2  C9 16          cmp #(FIELD_BOTTOM+1)
00010Dr 2  D0 D4          bne @sides
00010Fr 2  60             rts
000110r 2               
000110r 2               ; -----------------------------------------------------------------------------
000110r 2               ; DrawBoxFrame — draw a TILE_FRAME outline around the game-over overlay box
000110r 2               ; -----------------------------------------------------------------------------
000110r 2               DrawBoxFrame:
000110r 2  64 4D          stz SCAN_TMP
000112r 2               @topBottom:
000112r 2  A5 4D          lda SCAN_TMP
000114r 2  18             clc
000115r 2  69 06          adc #BOX_LEFT
000117r 2  AA             tax
000118r 2  A9 08          lda #BOX_TOP
00011Ar 2  A0 A0          ldy #TILE_FRAME
00011Cr 2  20 rr rr       jsr DrawTile
00011Fr 2               
00011Fr 2  A5 4D          lda SCAN_TMP
000121r 2  18             clc
000122r 2  69 06          adc #BOX_LEFT
000124r 2  AA             tax
000125r 2  A9 0F          lda #(BOX_TOP+BOX_HEIGHT-1)
000127r 2  A0 A0          ldy #TILE_FRAME
000129r 2  20 rr rr       jsr DrawTile
00012Cr 2               
00012Cr 2  E6 4D          inc SCAN_TMP
00012Er 2  A5 4D          lda SCAN_TMP
000130r 2  C9 14          cmp #BOX_WIDTH
000132r 2  D0 DE          bne @topBottom
000134r 2               
000134r 2  64 4D          stz SCAN_TMP
000136r 2               @sides:
000136r 2  A5 4D          lda SCAN_TMP
000138r 2  18             clc
000139r 2  69 08          adc #BOX_TOP
00013Br 2  A2 06          ldx #BOX_LEFT
00013Dr 2  A0 A0          ldy #TILE_FRAME
00013Fr 2  20 rr rr       jsr DrawTile
000142r 2               
000142r 2  A5 4D          lda SCAN_TMP
000144r 2  18             clc
000145r 2  69 08          adc #BOX_TOP
000147r 2  A2 19          ldx #(BOX_LEFT+BOX_WIDTH-1)
000149r 2  A0 A0          ldy #TILE_FRAME
00014Br 2  20 rr rr       jsr DrawTile
00014Er 2               
00014Er 2  E6 4D          inc SCAN_TMP
000150r 2  A5 4D          lda SCAN_TMP
000152r 2  C9 08          cmp #BOX_HEIGHT
000154r 2  D0 E0          bne @sides
000156r 2  60             rts
000157r 2               
000157r 2               ; -----------------------------------------------------------------------------
000157r 2               ; ClearBoxInterior — blank the overlay box's interior (excludes its 1-tile
000157r 2               ; frame border), erasing whatever snake/food was on the board underneath.
000157r 2               ; -----------------------------------------------------------------------------
000157r 2               ClearBoxInterior:
000157r 2  08             php
000158r 2  78             sei
000159r 2  A9 01          lda #1
00015Br 2  85 4D          sta SCAN_TMP
00015Dr 2               @rowLoop:
00015Dr 2  A5 4D          lda SCAN_TMP
00015Fr 2  18             clc
000160r 2  69 08          adc #BOX_TOP
000162r 2  A2 07          ldx #(BOX_LEFT+1)
000164r 2  20 rr rr       jsr ComputeOffset
000167r 2  20 rr rr       jsr VdpSetOffsetAddr
00016Ar 2  A0 00          ldy #0
00016Cr 2               @colLoop:
00016Cr 2  A9 20          lda #TILE_BLANK
00016Er 2  8D 00 9C       sta VC_DATA
000171r 2  C8             iny
000172r 2  C0 12          cpy #(BOX_WIDTH-2)
000174r 2  D0 F6          bne @colLoop
000176r 2               
000176r 2  E6 4D          inc SCAN_TMP
000178r 2  A5 4D          lda SCAN_TMP
00017Ar 2  C9 07          cmp #(BOX_HEIGHT-1)
00017Cr 2  D0 DF          bne @rowLoop
00017Er 2  28             plp
00017Fr 2  60             rts
000180r 2               
000180r 2               ; -----------------------------------------------------------------------------
000180r 2               ; WriteTilePatterns — copy the four custom 8x8 patterns into VRAM
000180r 2               ; -----------------------------------------------------------------------------
000180r 2               WriteTilePatterns:
000180r 2  08             php
000181r 2  78             sei
000182r 2  A9 00          lda #<PAT_HEAD_ADDR
000184r 2  A2 0C          ldx #>PAT_HEAD_ADDR
000186r 2  20 rr rr       jsr VdpSetAddr
000189r 2  A0 00          ldy #0
00018Br 2               @h:
00018Br 2  B9 rr rr       lda TileHeadData,y
00018Er 2  8D 00 9C       sta VC_DATA
000191r 2  C8             iny
000192r 2  C0 08          cpy #8
000194r 2  D0 F5          bne @h
000196r 2               
000196r 2  A9 40          lda #<PAT_BODY_ADDR
000198r 2  A2 0C          ldx #>PAT_BODY_ADDR
00019Ar 2  20 rr rr       jsr VdpSetAddr
00019Dr 2  A0 00          ldy #0
00019Fr 2               @b:
00019Fr 2  B9 rr rr       lda TileBodyData,y
0001A2r 2  8D 00 9C       sta VC_DATA
0001A5r 2  C8             iny
0001A6r 2  C0 08          cpy #8
0001A8r 2  D0 F5          bne @b
0001AAr 2               
0001AAr 2  A9 80          lda #<PAT_FOOD_ADDR
0001ACr 2  A2 0C          ldx #>PAT_FOOD_ADDR
0001AEr 2  20 rr rr       jsr VdpSetAddr
0001B1r 2  A0 00          ldy #0
0001B3r 2               @f:
0001B3r 2  B9 rr rr       lda TileFoodData,y
0001B6r 2  8D 00 9C       sta VC_DATA
0001B9r 2  C8             iny
0001BAr 2  C0 08          cpy #8
0001BCr 2  D0 F5          bne @f
0001BEr 2               
0001BEr 2  A9 C0          lda #<PAT_WALL_ADDR
0001C0r 2  A2 0C          ldx #>PAT_WALL_ADDR
0001C2r 2  20 rr rr       jsr VdpSetAddr
0001C5r 2  A0 00          ldy #0
0001C7r 2               @w:
0001C7r 2  B9 rr rr       lda TileWallData,y
0001CAr 2  8D 00 9C       sta VC_DATA
0001CDr 2  C8             iny
0001CEr 2  C0 08          cpy #8
0001D0r 2  D0 F5          bne @w
0001D2r 2               
0001D2r 2  A9 00          lda #<PAT_FRAME_ADDR
0001D4r 2  A2 0D          ldx #>PAT_FRAME_ADDR
0001D6r 2  20 rr rr       jsr VdpSetAddr
0001D9r 2  A0 00          ldy #0
0001DBr 2               @fr:
0001DBr 2  B9 rr rr       lda TileFrameData,y
0001DEr 2  8D 00 9C       sta VC_DATA
0001E1r 2  C8             iny
0001E2r 2  C0 08          cpy #8
0001E4r 2  D0 F5          bne @fr
0001E6r 2  28             plp
0001E7r 2  60             rts
0001E8r 2               
0001E8r 2               ; -----------------------------------------------------------------------------
0001E8r 2               ; InitGraphicsI — switch the VDP into Graphics I mode and build the screen
0001E8r 2               ; -----------------------------------------------------------------------------
0001E8r 2               InitGraphicsI:
0001E8r 2  AD 0D 03       lda HW_PRESENT
0001EBr 2  29 80          and #HW_VID
0001EDr 2  D0 09          bne @haveVideo
0001EFr 2               
0001EFr 2  A9 rr          lda #<NoVideoMsg
0001F1r 2  A0 rr          ldy #>NoVideoMsg
0001F3r 2  20 90 A0       jsr PrintStr
0001F6r 2               @haltLoop:
0001F6r 2  80 FE          bra @haltLoop
0001F8r 2               
0001F8r 2               @haveVideo:
0001F8r 2  08             php                      ; outer critical section for the whole setup —
0001F9r 2  78             sei                      ; covers the inline register/color-table writes
0001FAr 2                                           ; below that aren't wrapped by a called routine
0001FAr 2  A9 80          lda #$80
0001FCr 2  A2 01          ldx #1
0001FEr 2  20 rr rr       jsr VdpWriteReg          ; blank, 16K, Graphics I
000201r 2  A9 00          lda #$00
000203r 2  A2 00          ldx #0
000205r 2  20 rr rr       jsr VdpWriteReg
000208r 2  A9 00          lda #$00
00020Ar 2  A2 02          ldx #2
00020Cr 2  20 rr rr       jsr VdpWriteReg          ; name table @ $0000
00020Fr 2  A9 0C          lda #$0C
000211r 2  A2 03          ldx #3
000213r 2  20 rr rr       jsr VdpWriteReg          ; color table @ $0300
000216r 2  A9 01          lda #$01
000218r 2  A2 04          ldx #4
00021Ar 2  20 rr rr       jsr VdpWriteReg          ; pattern table @ $0800
00021Dr 2  A9 0E          lda #$0E
00021Fr 2  A2 05          ldx #5
000221r 2  20 rr rr       jsr VdpWriteReg          ; sprite attrs @ $0700 (unused)
000224r 2  A9 01          lda #$01
000226r 2  A2 06          ldx #6
000228r 2  20 rr rr       jsr VdpWriteReg          ; sprite patterns @ $0800
00022Br 2  A9 01          lda #TMS_BLACK
00022Dr 2  A2 07          ldx #7
00022Fr 2  20 rr rr       jsr VdpWriteReg          ; backdrop
000232r 2               
000232r 2                 ; disable the sprite list
000232r 2  A9 00          lda #$00
000234r 2  A2 07          ldx #$07
000236r 2  20 rr rr       jsr VdpSetAddr
000239r 2  A9 D0          lda #$D0
00023Br 2  8D 00 9C       sta VC_DATA
00023Er 2               
00023Er 2                 ; color table: fill all 32 groups with COLOR_TEXT, then punch in our 4
00023Er 2  A9 00          lda #$00
000240r 2  A2 03          ldx #$03
000242r 2  20 rr rr       jsr VdpSetAddr
000245r 2  A0 20          ldy #32
000247r 2               @colorLoop:
000247r 2  A9 F1          lda #COLOR_TEXT
000249r 2  8D 00 9C       sta VC_DATA
00024Cr 2  88             dey
00024Dr 2  D0 F8          bne @colorLoop
00024Fr 2               
00024Fr 2  A9 10          lda #<($0300+16)
000251r 2  A2 03          ldx #>($0300+16)
000253r 2  20 rr rr       jsr VdpSetAddr
000256r 2  A9 31          lda #COLOR_HEAD
000258r 2  8D 00 9C       sta VC_DATA
00025Br 2               
00025Br 2  A9 11          lda #<($0300+17)
00025Dr 2  A2 03          ldx #>($0300+17)
00025Fr 2  20 rr rr       jsr VdpSetAddr
000262r 2  A9 21          lda #COLOR_BODY
000264r 2  8D 00 9C       sta VC_DATA
000267r 2               
000267r 2  A9 12          lda #<($0300+18)
000269r 2  A2 03          ldx #>($0300+18)
00026Br 2  20 rr rr       jsr VdpSetAddr
00026Er 2  A9 81          lda #COLOR_FOOD
000270r 2  8D 00 9C       sta VC_DATA
000273r 2               
000273r 2  A9 13          lda #<($0300+19)
000275r 2  A2 03          ldx #>($0300+19)
000277r 2  20 rr rr       jsr VdpSetAddr
00027Ar 2  A9 E4          lda #COLOR_WALL
00027Cr 2  8D 00 9C       sta VC_DATA
00027Fr 2               
00027Fr 2  A9 14          lda #<($0300+20)
000281r 2  A2 03          ldx #>($0300+20)
000283r 2  20 rr rr       jsr VdpSetAddr
000286r 2  A9 BB          lda #COLOR_FRAME
000288r 2  8D 00 9C       sta VC_DATA
00028Br 2               
00028Br 2  20 rr rr       jsr WriteTilePatterns
00028Er 2  20 rr rr       jsr ClearScreen
000291r 2               
000291r 2  20 rr rr       jsr InitOccupancy
000294r 2  20 rr rr       jsr DrawBorder
000297r 2               
000297r 2  A9 C0          lda #$C0
000299r 2  A2 01          ldx #1
00029Br 2  20 rr rr       jsr VdpWriteReg          ; unblank
00029Er 2  28             plp
00029Fr 2  60             rts
0002A0r 2               
0002A0r 2               ; -----------------------------------------------------------------------------
0002A0r 2               ; ClearScreen — fill all 768 name-table cells with TILE_BLANK. Called once
0002A0r 2               ; from InitGraphicsI, and again from NewGame on every restart so a fresh
0002A0r 2               ; game never shows the previous game's leftover snake/food tiles.
0002A0r 2               ; -----------------------------------------------------------------------------
0002A0r 2               ClearScreen:
0002A0r 2  08             php
0002A1r 2  78             sei
0002A2r 2  A9 00          lda #$00
0002A4r 2  A2 00          ldx #$00
0002A6r 2  20 rr rr       jsr VdpSetAddr
0002A9r 2  A2 00          ldx #0
0002ABr 2  A0 03          ldy #3
0002ADr 2               @nameLoop:
0002ADr 2  A9 20          lda #TILE_BLANK
0002AFr 2  8D 00 9C       sta VC_DATA
0002B2r 2  E8             inx
0002B3r 2  D0 F8          bne @nameLoop
0002B5r 2  88             dey
0002B6r 2  D0 F5          bne @nameLoop
0002B8r 2  28             plp
0002B9r 2  60             rts
0002BAr 2               
0002BAr 2               NoVideoMsg:
0002BAr 2  0D 0A 4E 4F    .byte CHAR_CR, CHAR_LF, "NO VIDEO CARD DETECTED", CHAR_CR, CHAR_LF, $00
0002BEr 2  20 56 49 44  
0002C2r 2  45 4F 20 43  
0002D5r 2               
0002D5r 1               .include "src/rng.asm"
0002D5r 2               ; =============================================================================
0002D5r 2               ;   rng.asm — 8-bit Galois LFSR pseudo-random generator
0002D5r 2               ; =============================================================================
0002D5r 2               
0002D5r 2               .segment "CART"
0002D5r 2               
0002D5r 2               ; -----------------------------------------------------------------------------
0002D5r 2               ; AdvanceRng — step the LFSR one bit (maximal-length, period 255)
0002D5r 2               ; -----------------------------------------------------------------------------
0002D5r 2               AdvanceRng:
0002D5r 2  A5 46          lda RNG_STATE
0002D7r 2  4A             lsr a
0002D8r 2  90 02          bcc @noeor
0002DAr 2  49 B4          eor #$B4
0002DCr 2               @noeor:
0002DCr 2  85 46          sta RNG_STATE
0002DEr 2  60             rts
0002DFr 2               
0002DFr 2               ; -----------------------------------------------------------------------------
0002DFr 2               ; RollCol — random playfield column
0002DFr 2               ; Out: A in [FIELD_LEFT, FIELD_RIGHT]
0002DFr 2               ; -----------------------------------------------------------------------------
0002DFr 2               RollCol:
0002DFr 2  20 rr rr       jsr AdvanceRng
0002E2r 2  A5 46          lda RNG_STATE
0002E4r 2               @reduce:
0002E4r 2  C9 1E          cmp #(FIELD_RIGHT-FIELD_LEFT+1)
0002E6r 2  90 06          bcc @done
0002E8r 2  38             sec
0002E9r 2  E9 1E          sbc #(FIELD_RIGHT-FIELD_LEFT+1)
0002EBr 2  4C rr rr       jmp @reduce
0002EEr 2               @done:
0002EEr 2  18             clc
0002EFr 2  69 01          adc #FIELD_LEFT
0002F1r 2  60             rts
0002F2r 2               
0002F2r 2               ; -----------------------------------------------------------------------------
0002F2r 2               ; RollRow — random playfield row
0002F2r 2               ; Out: A in [FIELD_TOP, FIELD_BOTTOM]
0002F2r 2               ; -----------------------------------------------------------------------------
0002F2r 2               RollRow:
0002F2r 2  20 rr rr       jsr AdvanceRng
0002F5r 2  A5 46          lda RNG_STATE
0002F7r 2               @reduce:
0002F7r 2  C9 14          cmp #(FIELD_BOTTOM-FIELD_TOP+1)
0002F9r 2  90 06          bcc @done
0002FBr 2  38             sec
0002FCr 2  E9 14          sbc #(FIELD_BOTTOM-FIELD_TOP+1)
0002FEr 2  4C rr rr       jmp @reduce
000301r 2               @done:
000301r 2  18             clc
000302r 2  69 02          adc #FIELD_TOP
000304r 2  60             rts
000305r 2               
000305r 1               .include "src/input.asm"
000305r 2               ; =============================================================================
000305r 2               ;   input.asm — joystick + keyboard polling
000305r 2               ; =============================================================================
000305r 2               ;   ReadJoystick1 does NOT check HW_PRESENT (6502.inc explicitly warns a
000305r 2               ;   floating bus reads as meaningless), so we gate on HW_GPIO ourselves.
000305r 2               ;   Bit layout (active low):  7=R 6=L 5=D 4=U 3=Y 2=X 1=B 0=A
000305r 2               ; =============================================================================
000305r 2               
000305r 2               JOY_FIRE  = %00000001
000305r 2               JOY_UP    = %00010000
000305r 2               JOY_DOWN  = %00100000
000305r 2               JOY_LEFT  = %01000000
000305r 2               JOY_RIGHT = %10000000
000305r 2               
000305r 2               ; Arrow keys arrive as control codes, not 'W'/'A'/'S'/'D' — confirmed against
000305r 2               ; the emulator's USB-HID-to-ASCII keyboard tables (KeyboardEncoderAttachment
000305r 2               ; and KeyboardMatrixAttachment both agree on these four).
000305r 2               KEY_UP    = $1E
000305r 2               KEY_DOWN  = $1F
000305r 2               KEY_LEFT  = $1C
000305r 2               KEY_RIGHT = $1D
000305r 2               
000305r 2               .segment "CART"
000305r 2               
000305r 2               ; -----------------------------------------------------------------------------
000305r 2               ; PollInput — sample joystick (if present) and drain the keyboard buffer,
000305r 2               ; updating NEXT_DIR and START_PRESSED. Safe to call every frame regardless
000305r 2               ; of GAME_STATE.
000305r 2               ; -----------------------------------------------------------------------------
000305r 2               PollInput:
000305r 2  64 60          stz START_PRESSED
000307r 2               
000307r 2  AD 0D 03       lda HW_PRESENT
00030Ar 2  29 20          and #HW_GPIO
00030Cr 2  F0 37          beq @kbOnly
00030Er 2               
00030Er 2  20 48 A0       jsr ReadJoystick1
000311r 2  85 54          sta JOY_STATE
000313r 2               
000313r 2  A5 54          lda JOY_STATE
000315r 2  29 10          and #JOY_UP
000317r 2  D0 04          bne @jNotUp
000319r 2  A9 00          lda #DIR_UP
00031Br 2  85 3C          sta NEXT_DIR
00031Dr 2               @jNotUp:
00031Dr 2  A5 54          lda JOY_STATE
00031Fr 2  29 20          and #JOY_DOWN
000321r 2  D0 04          bne @jNotDown
000323r 2  A9 01          lda #DIR_DOWN
000325r 2  85 3C          sta NEXT_DIR
000327r 2               @jNotDown:
000327r 2  A5 54          lda JOY_STATE
000329r 2  29 40          and #JOY_LEFT
00032Br 2  D0 04          bne @jNotLeft
00032Dr 2  A9 02          lda #DIR_LEFT
00032Fr 2  85 3C          sta NEXT_DIR
000331r 2               @jNotLeft:
000331r 2  A5 54          lda JOY_STATE
000333r 2  29 80          and #JOY_RIGHT
000335r 2  D0 04          bne @jNotRight
000337r 2  A9 03          lda #DIR_RIGHT
000339r 2  85 3C          sta NEXT_DIR
00033Br 2               @jNotRight:
00033Br 2  A5 54          lda JOY_STATE
00033Dr 2  29 01          and #JOY_FIRE
00033Fr 2  D0 04          bne @jNotFire
000341r 2  A9 01          lda #1
000343r 2  85 60          sta START_PRESSED
000345r 2               @jNotFire:
000345r 2               
000345r 2               @kbOnly:
000345r 2               @drain:
000345r 2  20 03 A0       jsr Chrin
000348r 2  90 51          bcc @doneDrain
00034Ar 2  85 55          sta KB_CHAR
00034Cr 2               
00034Cr 2  C9 57          cmp #'W'
00034Er 2  F0 04          beq @setUp
000350r 2  C9 1E          cmp #KEY_UP
000352r 2  D0 07          bne @notW
000354r 2               @setUp:
000354r 2  A9 00          lda #DIR_UP
000356r 2  85 3C          sta NEXT_DIR
000358r 2  4C rr rr       jmp @drain
00035Br 2               @notW:
00035Br 2  A5 55          lda KB_CHAR
00035Dr 2  C9 53          cmp #'S'
00035Fr 2  F0 04          beq @setDown
000361r 2  C9 1F          cmp #KEY_DOWN
000363r 2  D0 07          bne @notS
000365r 2               @setDown:
000365r 2  A9 01          lda #DIR_DOWN
000367r 2  85 3C          sta NEXT_DIR
000369r 2  4C rr rr       jmp @drain
00036Cr 2               @notS:
00036Cr 2  A5 55          lda KB_CHAR
00036Er 2  C9 41          cmp #'A'
000370r 2  F0 04          beq @setLeft
000372r 2  C9 1C          cmp #KEY_LEFT
000374r 2  D0 07          bne @notA
000376r 2               @setLeft:
000376r 2  A9 02          lda #DIR_LEFT
000378r 2  85 3C          sta NEXT_DIR
00037Ar 2  4C rr rr       jmp @drain
00037Dr 2               @notA:
00037Dr 2  A5 55          lda KB_CHAR
00037Fr 2  C9 44          cmp #'D'
000381r 2  F0 04          beq @setRight
000383r 2  C9 1D          cmp #KEY_RIGHT
000385r 2  D0 07          bne @notD
000387r 2               @setRight:
000387r 2  A9 03          lda #DIR_RIGHT
000389r 2  85 3C          sta NEXT_DIR
00038Br 2  4C rr rr       jmp @drain
00038Er 2               @notD:
00038Er 2  A5 55          lda KB_CHAR
000390r 2  C9 20          cmp #' '
000392r 2  D0 B1          bne @drain
000394r 2  A9 01          lda #1
000396r 2  85 60          sta START_PRESSED
000398r 2  4C rr rr       jmp @drain
00039Br 2               
00039Br 2               @doneDrain:
00039Br 2                 ; Edge-detect fire/space: FIRE_EDGE is set only on the poll it first goes
00039Br 2                 ; down, so a held button (in particular a held joystick fire, which reads
00039Br 2                 ; as continuously down every poll) doesn't repeatedly re-trigger
00039Br 2                 ; pause/resume/restart on every subsequent tick.
00039Br 2  64 62          stz FIRE_EDGE
00039Dr 2  A5 61          lda PREV_FIRE
00039Fr 2  D0 06          bne @noEdge
0003A1r 2  A5 60          lda START_PRESSED
0003A3r 2  F0 02          beq @noEdge
0003A5r 2  E6 62          inc FIRE_EDGE
0003A7r 2               @noEdge:
0003A7r 2  A5 60          lda START_PRESSED
0003A9r 2  85 61          sta PREV_FIRE
0003ABr 2  60             rts
0003ACr 2               
0003ACr 1               .include "src/sound.asm"
0003ACr 2               ; =============================================================================
0003ACr 2               ;   sound.asm — eat / death sound feedback
0003ACr 2               ; =============================================================================
0003ACr 2               ;   Beep is guaranteed safe (self-no-ops with no SID card) but blocks the
0003ACr 2               ;   CPU for its full ~300ms tone duration — fine for a one-off like
0003ACr 2               ;   GameOver, but audible every apple pickup as a freeze twice as long as
0003ACr 2               ;   a game tick. Sound_Eat instead drives SidPlayNote/SidSilence directly:
0003ACr 2               ;   both are plain register writes with no delay loop, so they return to
0003ACr 2               ;   the caller immediately. The SID's own envelope hardware keeps ringing
0003ACr 2               ;   the note out in real time after that — gating off right away just
0003ACr 2               ;   starts the (already short, full-sustain) release phase, it doesn't
0003ACr 2               ;   cut the sound short. Also self-no-ops with no SID fitted.
0003ACr 2               ; =============================================================================
0003ACr 2               
0003ACr 2               .segment "CART"
0003ACr 2               
0003ACr 2               Sound_Eat:
0003ACr 2  A9 00          lda #0
0003AEr 2  A2 69          ldx #<SID_NOTE_E6
0003B0r 2  A0 56          ldy #>SID_NOTE_E6
0003B2r 2  20 33 A0       jsr SidPlayNote
0003B5r 2  20 36 A0       jsr SidSilence
0003B8r 2  60             rts
0003B9r 2               
0003B9r 2               Sound_Death:
0003B9r 2  20 30 A0       jsr Beep
0003BCr 2  20 30 A0       jsr Beep
0003BFr 2  60             rts
0003C0r 2               
0003C0r 1               .include "src/game.asm"
0003C0r 2               ; =============================================================================
0003C0r 2               ;   game.asm — Snake state machine: title wait, tick logic, HUD, game over
0003C0r 2               ; =============================================================================
0003C0r 2               
0003C0r 2               .segment "CART"
0003C0r 2               
0003C0r 2               ; -----------------------------------------------------------------------------
0003C0r 2               ; DrawTitleScreen — draw the title screen in Graphics I, using the same
0003C0r 2               ; tiles/palette as gameplay (called once at boot, before WaitForStart, on
0003C0r 2               ; top of the border InitGraphicsI already drew). Every line's column is
0003C0r 2               ; computed for exact centering in the 32-wide grid.
0003C0r 2               ; -----------------------------------------------------------------------------
0003C0r 2               DrawTitleScreen:
0003C0r 2  A9 rr          lda #<TitleText
0003C2r 2  85 56          sta WORK_PTR
0003C4r 2  A9 rr          lda #>TitleText
0003C6r 2  85 57          sta WORK_PTR+1
0003C8r 2  A9 08          lda #8
0003CAr 2  A2 0B          ldx #11
0003CCr 2  20 rr rr       jsr DrawString
0003CFr 2               
0003CFr 2                 ; snake + apple decoration, row 10: the same tiles used in gameplay, so
0003CFr 2                 ; the title screen reads as the same game, not a splash screen bolted
0003CFr 2                 ; on top of it. "S N A K E" above (cols 11-19) is the point of
0003CFr 2                 ; reference — the body underlines the whole word and runs a couple
0003CFr 2                 ; cells past it on both ends, with the head chasing a nearby apple.
0003CFr 2  A9 09          lda #9
0003D1r 2  85 4D          sta SCAN_TMP
0003D3r 2               @titleSnakeBody:
0003D3r 2  A9 0A          lda #10
0003D5r 2  A6 4D          ldx SCAN_TMP
0003D7r 2  A0 88          ldy #TILE_BODY
0003D9r 2  20 rr rr       jsr DrawTile
0003DCr 2  E6 4D          inc SCAN_TMP
0003DEr 2  A5 4D          lda SCAN_TMP
0003E0r 2  C9 14          cmp #20
0003E2r 2  D0 EF          bne @titleSnakeBody
0003E4r 2               
0003E4r 2  A9 0A          lda #10
0003E6r 2  A2 14          ldx #20
0003E8r 2  A0 80          ldy #TILE_HEAD
0003EAr 2  20 rr rr       jsr DrawTile
0003EDr 2               
0003EDr 2  A9 0A          lda #10
0003EFr 2  A2 16          ldx #22
0003F1r 2  A0 90          ldy #TILE_FOOD
0003F3r 2  20 rr rr       jsr DrawTile
0003F6r 2               
0003F6r 2  A9 rr          lda #<HighScoreLabel
0003F8r 2  85 56          sta WORK_PTR
0003FAr 2  A9 rr          lda #>HighScoreLabel
0003FCr 2  85 57          sta WORK_PTR+1
0003FEr 2  A9 0C          lda #12
000400r 2  A2 07          ldx #7
000402r 2  20 rr rr       jsr DrawString
000405r 2  A5 65          lda HIGH_SCORE_LO
000407r 2  A6 66          ldx HIGH_SCORE_HI
000409r 2  20 rr rr       jsr ValueToDigits
00040Cr 2  A9 0C          lda #12
00040Er 2  A2 13          ldx #19
000410r 2  20 rr rr       jsr DrawDigitBuf
000413r 2               
000413r 2  A9 rr          lda #<MoveHelpMsg
000415r 2  85 56          sta WORK_PTR
000417r 2  A9 rr          lda #>MoveHelpMsg
000419r 2  85 57          sta WORK_PTR+1
00041Br 2  A9 0E          lda #14
00041Dr 2  A2 01          ldx #1
00041Fr 2  20 rr rr       jsr DrawString
000422r 2               
000422r 2  A9 rr          lda #<StartPromptMsg
000424r 2  85 56          sta WORK_PTR
000426r 2  A9 rr          lda #>StartPromptMsg
000428r 2  85 57          sta WORK_PTR+1
00042Ar 2  A9 0F          lda #15
00042Cr 2  A2 02          ldx #2
00042Er 2  4C rr rr       jmp DrawString
000431r 2               
000431r 2               ; -----------------------------------------------------------------------------
000431r 2               ; WaitForStart — title-screen loop. Polls for fire/space, seeds RNG_STATE
000431r 2               ; from elapsed loop iterations (reaction-time entropy) plus the RTC clock
000431r 2               ; if fitted.
000431r 2               ; -----------------------------------------------------------------------------
000431r 2               WaitForStart:
000431r 2  64 46          stz RNG_STATE
000433r 2               @loop:
000433r 2  E6 46          inc RNG_STATE
000435r 2  20 rr rr       jsr PollInput
000438r 2  A5 60          lda START_PRESSED
00043Ar 2  D0 03          bne @done
00043Cr 2  4C rr rr       jmp @loop
00043Fr 2               @done:
00043Fr 2  AD 0D 03       lda HW_PRESENT
000442r 2  29 04          and #HW_RTC
000444r 2  F0 11          beq @noRtc
000446r 2  20 5A A0       jsr RtcReadTime          ; A=hours, X=minutes, Y=seconds
000449r 2  45 46          eor RNG_STATE
00044Br 2  85 46          sta RNG_STATE
00044Dr 2  8A             txa
00044Er 2  45 46          eor RNG_STATE
000450r 2  85 46          sta RNG_STATE
000452r 2  98             tya
000453r 2  45 46          eor RNG_STATE
000455r 2  85 46          sta RNG_STATE
000457r 2               @noRtc:
000457r 2  A5 46          lda RNG_STATE
000459r 2  D0 04          bne @nonzero
00045Br 2  A9 2A          lda #$2A
00045Dr 2  85 46          sta RNG_STATE
00045Fr 2               @nonzero:
00045Fr 2  60             rts
000460r 2               
000460r 2               ; -----------------------------------------------------------------------------
000460r 2               ; NewGame — reset the playfield and snake for a fresh game (also used to
000460r 2               ; restart from GAMEOVER; safe to call repeatedly since it fully redraws the
000460r 2               ; occupancy grid and border rather than tracking incremental cleanup).
000460r 2               ; -----------------------------------------------------------------------------
000460r 2               NewGame:
000460r 2  20 rr rr       jsr ClearScreen          ; wipe any leftover snake/food/message from a
000463r 2                                           ; previous game before rebuilding the board
000463r 2  20 rr rr       jsr InitOccupancy
000466r 2  20 rr rr       jsr DrawBorder
000469r 2               
000469r 2  A9 0F          lda #15
00046Br 2  8D 00 08       sta SEGMENTS_X
00046Er 2  A9 0C          lda #12
000470r 2  8D 00 09       sta SEGMENTS_Y
000473r 2  A9 10          lda #16
000475r 2  8D 01 08       sta SEGMENTS_X+1
000478r 2  A9 0C          lda #12
00047Ar 2  8D 01 09       sta SEGMENTS_Y+1
00047Dr 2  A9 11          lda #17
00047Fr 2  8D 02 08       sta SEGMENTS_X+2
000482r 2  A9 0C          lda #12
000484r 2  8D 02 09       sta SEGMENTS_Y+2
000487r 2               
000487r 2  A9 00          lda #0
000489r 2  85 40          sta TAIL_IDX
00048Br 2  A9 02          lda #2
00048Dr 2  85 3F          sta HEAD_IDX
00048Fr 2  A9 03          lda #3
000491r 2  85 41          sta SNAKE_LEN
000493r 2  A9 11          lda #17
000495r 2  85 3D          sta HEAD_X
000497r 2  A9 0C          lda #12
000499r 2  85 3E          sta HEAD_Y
00049Br 2  A9 03          lda #DIR_RIGHT
00049Dr 2  85 3B          sta DIRECTION
00049Fr 2  85 3C          sta NEXT_DIR
0004A1r 2  A9 00          lda #0
0004A3r 2  85 44          sta SCORE_LO
0004A5r 2  85 45          sta SCORE_HI
0004A7r 2               
0004A7r 2  A9 0C          lda #12
0004A9r 2  A2 0F          ldx #15
0004ABr 2  A0 01          ldy #1
0004ADr 2  20 rr rr       jsr OccupancySet
0004B0r 2  A9 0C          lda #12
0004B2r 2  A2 10          ldx #16
0004B4r 2  A0 01          ldy #1
0004B6r 2  20 rr rr       jsr OccupancySet
0004B9r 2  A9 0C          lda #12
0004BBr 2  A2 11          ldx #17
0004BDr 2  A0 01          ldy #1
0004BFr 2  20 rr rr       jsr OccupancySet
0004C2r 2               
0004C2r 2  A9 0C          lda #12
0004C4r 2  A2 0F          ldx #15
0004C6r 2  A0 88          ldy #TILE_BODY
0004C8r 2  20 rr rr       jsr DrawTile
0004CBr 2  A9 0C          lda #12
0004CDr 2  A2 10          ldx #16
0004CFr 2  A0 88          ldy #TILE_BODY
0004D1r 2  20 rr rr       jsr DrawTile
0004D4r 2  A9 0C          lda #12
0004D6r 2  A2 11          ldx #17
0004D8r 2  A0 80          ldy #TILE_HEAD
0004DAr 2  20 rr rr       jsr DrawTile
0004DDr 2               
0004DDr 2  20 rr rr       jsr RespawnFood
0004E0r 2  20 rr rr       jsr DrawHudLabel
0004E3r 2  20 rr rr       jsr UpdateHud
0004E6r 2               
0004E6r 2  A9 01          lda #STATE_PLAYING
0004E8r 2  85 3A          sta GAME_STATE
0004EAr 2  60             rts
0004EBr 2               
0004EBr 2               ; -----------------------------------------------------------------------------
0004EBr 2               ; Tick — advance the snake one grid step
0004EBr 2               ; -----------------------------------------------------------------------------
0004EBr 2               Tick:
0004EBr 2  A5 3B          lda DIRECTION
0004EDr 2  49 01          eor #1
0004EFr 2  C5 3C          cmp NEXT_DIR
0004F1r 2  F0 04          beq @skipDirUpdate
0004F3r 2  A5 3C          lda NEXT_DIR
0004F5r 2  85 3B          sta DIRECTION
0004F7r 2               @skipDirUpdate:
0004F7r 2               
0004F7r 2  A5 3D          lda HEAD_X
0004F9r 2  85 47          sta NEW_HEAD_X
0004FBr 2  A5 3E          lda HEAD_Y
0004FDr 2  85 48          sta NEW_HEAD_Y
0004FFr 2               
0004FFr 2  A5 3B          lda DIRECTION
000501r 2  C9 00          cmp #DIR_UP
000503r 2  D0 05          bne @notUp
000505r 2  C6 48          dec NEW_HEAD_Y
000507r 2  4C rr rr       jmp @dirDone
00050Ar 2               @notUp:
00050Ar 2  C9 01          cmp #DIR_DOWN
00050Cr 2  D0 05          bne @notDown
00050Er 2  E6 48          inc NEW_HEAD_Y
000510r 2  4C rr rr       jmp @dirDone
000513r 2               @notDown:
000513r 2  C9 02          cmp #DIR_LEFT
000515r 2  D0 05          bne @notLeft
000517r 2  C6 47          dec NEW_HEAD_X
000519r 2  4C rr rr       jmp @dirDone
00051Cr 2               @notLeft:
00051Cr 2  E6 47          inc NEW_HEAD_X
00051Er 2               @dirDone:
00051Er 2               
00051Er 2  A5 47          lda NEW_HEAD_X
000520r 2  C5 42          cmp FOOD_X
000522r 2  D0 0D          bne @notFood
000524r 2  A5 48          lda NEW_HEAD_Y
000526r 2  C5 43          cmp FOOD_Y
000528r 2  D0 07          bne @notFood
00052Ar 2  A9 01          lda #1
00052Cr 2  85 49          sta GROW_FLAG
00052Er 2  4C rr rr       jmp @foodCheckDone
000531r 2               @notFood:
000531r 2  A9 00          lda #0
000533r 2  85 49          sta GROW_FLAG
000535r 2               @foodCheckDone:
000535r 2               
000535r 2  A5 48          lda NEW_HEAD_Y
000537r 2  A6 47          ldx NEW_HEAD_X
000539r 2  20 rr rr       jsr OccupancyGet
00053Cr 2  C9 00          cmp #0
00053Er 2  F0 1E          beq @moveOk
000540r 2  C9 03          cmp #3
000542r 2  F0 17          beq @collision
000544r 2               
000544r 2  A5 49          lda GROW_FLAG
000546r 2  D0 13          bne @collision
000548r 2               
000548r 2  A4 40          ldy TAIL_IDX
00054Ar 2  B9 00 08       lda SEGMENTS_X,y
00054Dr 2  C5 47          cmp NEW_HEAD_X
00054Fr 2  D0 0A          bne @collision
000551r 2  B9 00 09       lda SEGMENTS_Y,y
000554r 2  C5 48          cmp NEW_HEAD_Y
000556r 2  D0 03          bne @collision
000558r 2  4C rr rr       jmp @moveOk
00055Br 2               
00055Br 2               @collision:
00055Br 2  4C rr rr       jmp GameOver
00055Er 2               
00055Er 2               @moveOk:
00055Er 2  A5 3E          lda HEAD_Y
000560r 2  A6 3D          ldx HEAD_X
000562r 2  A0 88          ldy #TILE_BODY
000564r 2  20 rr rr       jsr DrawTile
000567r 2               
000567r 2  E6 3F          inc HEAD_IDX
000569r 2  A4 3F          ldy HEAD_IDX
00056Br 2  A5 47          lda NEW_HEAD_X
00056Dr 2  99 00 08       sta SEGMENTS_X,y
000570r 2  A5 48          lda NEW_HEAD_Y
000572r 2  99 00 09       sta SEGMENTS_Y,y
000575r 2               
000575r 2  A5 47          lda NEW_HEAD_X
000577r 2  85 3D          sta HEAD_X
000579r 2  A5 48          lda NEW_HEAD_Y
00057Br 2  85 3E          sta HEAD_Y
00057Dr 2               
00057Dr 2  A5 3E          lda HEAD_Y
00057Fr 2  A6 3D          ldx HEAD_X
000581r 2  A0 01          ldy #1
000583r 2  20 rr rr       jsr OccupancySet
000586r 2               
000586r 2  A5 3E          lda HEAD_Y
000588r 2  A6 3D          ldx HEAD_X
00058Ar 2  A0 80          ldy #TILE_HEAD
00058Cr 2  20 rr rr       jsr DrawTile
00058Fr 2               
00058Fr 2  A5 49          lda GROW_FLAG
000591r 2  F0 1B          beq @noGrow
000593r 2               
000593r 2  E6 41          inc SNAKE_LEN
000595r 2  18             clc
000596r 2  A5 44          lda SCORE_LO
000598r 2  69 0A          adc #10
00059Ar 2  85 44          sta SCORE_LO
00059Cr 2  A5 45          lda SCORE_HI
00059Er 2  69 00          adc #0
0005A0r 2  85 45          sta SCORE_HI
0005A2r 2  20 rr rr       jsr UpdateHud
0005A5r 2  20 rr rr       jsr Sound_Eat
0005A8r 2  20 rr rr       jsr RespawnFood
0005ABr 2  4C rr rr       jmp @tickDone
0005AEr 2               
0005AEr 2               @noGrow:
0005AEr 2  A4 40          ldy TAIL_IDX
0005B0r 2  B9 00 08       lda SEGMENTS_X,y
0005B3r 2  85 58          sta OLD_TAIL_X
0005B5r 2  B9 00 09       lda SEGMENTS_Y,y
0005B8r 2  85 59          sta OLD_TAIL_Y
0005BAr 2               
0005BAr 2  A5 59          lda OLD_TAIL_Y
0005BCr 2  A6 58          ldx OLD_TAIL_X
0005BEr 2  A0 00          ldy #0
0005C0r 2  20 rr rr       jsr OccupancySet
0005C3r 2               
0005C3r 2  A5 59          lda OLD_TAIL_Y
0005C5r 2  A6 58          ldx OLD_TAIL_X
0005C7r 2  20 rr rr       jsr EraseTile
0005CAr 2               
0005CAr 2  E6 40          inc TAIL_IDX
0005CCr 2               
0005CCr 2               @tickDone:
0005CCr 2  60             rts
0005CDr 2               
0005CDr 2               ; -----------------------------------------------------------------------------
0005CDr 2               ; GameOver
0005CDr 2               ; -----------------------------------------------------------------------------
0005CDr 2               GameOver:
0005CDr 2  A9 02          lda #STATE_GAMEOVER
0005CFr 2  85 3A          sta GAME_STATE
0005D1r 2  20 rr rr       jsr Sound_Death
0005D4r 2               
0005D4r 2  64 67          stz NEW_HIGH_FLAG
0005D6r 2  A5 45          lda SCORE_HI
0005D8r 2  C5 66          cmp HIGH_SCORE_HI
0005DAr 2  90 19          bcc @notHigh
0005DCr 2  D0 08          bne @isHigh
0005DEr 2  A5 44          lda SCORE_LO
0005E0r 2  C5 65          cmp HIGH_SCORE_LO
0005E2r 2  90 11          bcc @notHigh
0005E4r 2  F0 0F          beq @notHigh            ; a tied score doesn't count as a NEW high
0005E6r 2               @isHigh:
0005E6r 2  A5 44          lda SCORE_LO
0005E8r 2  85 65          sta HIGH_SCORE_LO
0005EAr 2  A5 45          lda SCORE_HI
0005ECr 2  85 66          sta HIGH_SCORE_HI
0005EEr 2  A9 01          lda #1
0005F0r 2  85 67          sta NEW_HIGH_FLAG
0005F2r 2  20 rr rr       jsr SaveHighScore
0005F5r 2               @notHigh:
0005F5r 2  20 rr rr       jsr DrawGameOverOverlay
0005F8r 2  60             rts
0005F9r 2               
0005F9r 2               ; -----------------------------------------------------------------------------
0005F9r 2               ; High score persistence — the cartridge ROM itself is read-only and can't
0005F9r 2               ; store anything, but the RTC card (when fitted) carries 256 bytes of
0005F9r 2               ; battery-backed NVRAM that survives power cycles. We use 3 of those bytes:
0005F9r 2               ; a signature (to tell "our data" from an untouched/foreign NVRAM) plus the
0005F9r 2               ; 16-bit score. With no RTC card, the high score is still tracked — it just
0005F9r 2               ; lives in RAM only and resets whenever the machine is powered off.
0005F9r 2               ; -----------------------------------------------------------------------------
0005F9r 2               NVRAM_SIG_ADDR      = 0
0005F9r 2               NVRAM_SCORE_LO_ADDR = 1
0005F9r 2               NVRAM_SCORE_HI_ADDR = 2
0005F9r 2               NVRAM_MAGIC         = $A5
0005F9r 2               
0005F9r 2               ; LoadHighScore — call once at boot, before the title screen is drawn
0005F9r 2               LoadHighScore:
0005F9r 2  64 65          stz HIGH_SCORE_LO
0005FBr 2  64 66          stz HIGH_SCORE_HI
0005FDr 2  AD 0D 03       lda HW_PRESENT
000600r 2  29 04          and #HW_RTC
000602r 2  F0 17          beq @done
000604r 2  A2 00          ldx #NVRAM_SIG_ADDR
000606r 2  20 66 A0       jsr RtcReadNVRAM
000609r 2  C9 A5          cmp #NVRAM_MAGIC
00060Br 2  D0 0E          bne @done                ; untouched NVRAM (or a different program's data) -> start at 0
00060Dr 2  A2 01          ldx #NVRAM_SCORE_LO_ADDR
00060Fr 2  20 66 A0       jsr RtcReadNVRAM
000612r 2  85 65          sta HIGH_SCORE_LO
000614r 2  A2 02          ldx #NVRAM_SCORE_HI_ADDR
000616r 2  20 66 A0       jsr RtcReadNVRAM
000619r 2  85 66          sta HIGH_SCORE_HI
00061Br 2               @done:
00061Br 2  60             rts
00061Cr 2               
00061Cr 2               ; SaveHighScore — call whenever HIGH_SCORE_LO/HI changes
00061Cr 2               SaveHighScore:
00061Cr 2  AD 0D 03       lda HW_PRESENT
00061Fr 2  29 04          and #HW_RTC
000621r 2  F0 15          beq @done                ; no RTC card -> nothing to persist to, skip silently
000623r 2  A9 A5          lda #NVRAM_MAGIC
000625r 2  A2 00          ldx #NVRAM_SIG_ADDR
000627r 2  20 69 A0       jsr RtcWriteNVRAM
00062Ar 2  A5 65          lda HIGH_SCORE_LO
00062Cr 2  A2 01          ldx #NVRAM_SCORE_LO_ADDR
00062Er 2  20 69 A0       jsr RtcWriteNVRAM
000631r 2  A5 66          lda HIGH_SCORE_HI
000633r 2  A2 02          ldx #NVRAM_SCORE_HI_ADDR
000635r 2  20 69 A0       jsr RtcWriteNVRAM
000638r 2               @done:
000638r 2  60             rts
000639r 2               
000639r 2               ; -----------------------------------------------------------------------------
000639r 2               ; RespawnFood — place food on a random empty cell (bounded retry)
000639r 2               ; -----------------------------------------------------------------------------
000639r 2               RespawnFood:
000639r 2  64 4C          stz RETRY_CNT
00063Br 2               @try:
00063Br 2  20 rr rr       jsr RollCol
00063Er 2  85 42          sta FOOD_X
000640r 2  20 rr rr       jsr RollRow
000643r 2  85 43          sta FOOD_Y
000645r 2               
000645r 2  A5 43          lda FOOD_Y
000647r 2  A6 42          ldx FOOD_X
000649r 2  20 rr rr       jsr OccupancyGet
00064Cr 2  C9 00          cmp #0
00064Er 2  F0 10          beq @placed
000650r 2               
000650r 2  E6 4C          inc RETRY_CNT
000652r 2  A5 4C          lda RETRY_CNT
000654r 2  C9 20          cmp #32
000656r 2  D0 E3          bne @try
000658r 2               
000658r 2  A9 01          lda #FIELD_LEFT
00065Ar 2  85 42          sta FOOD_X
00065Cr 2  A9 02          lda #FIELD_TOP
00065Er 2  85 43          sta FOOD_Y
000660r 2               
000660r 2               @placed:
000660r 2  A5 43          lda FOOD_Y
000662r 2  A6 42          ldx FOOD_X
000664r 2  A0 90          ldy #TILE_FOOD
000666r 2  20 rr rr       jsr DrawTile
000669r 2  60             rts
00066Ar 2               
00066Ar 2               ; -----------------------------------------------------------------------------
00066Ar 2               ; Decimal HUD helpers
00066Ar 2               ; -----------------------------------------------------------------------------
00066Ar 2               
00066Ar 2               ; Sub16IfGE — if SC_TMP >= SUB, subtract and return carry set; else carry clear
00066Ar 2               Sub16IfGE:
00066Ar 2  A5 5C          lda SC_TMP_HI
00066Cr 2  C5 5E          cmp SUB_HI
00066Er 2  90 17          bcc @no
000670r 2  D0 06          bne @yes
000672r 2  A5 5B          lda SC_TMP_LO
000674r 2  C5 5D          cmp SUB_LO
000676r 2  90 0F          bcc @no
000678r 2               @yes:
000678r 2  A5 5B          lda SC_TMP_LO
00067Ar 2  38             sec
00067Br 2  E5 5D          sbc SUB_LO
00067Dr 2  85 5B          sta SC_TMP_LO
00067Fr 2  A5 5C          lda SC_TMP_HI
000681r 2  E5 5E          sbc SUB_HI
000683r 2  85 5C          sta SC_TMP_HI
000685r 2  38             sec
000686r 2  60             rts
000687r 2               @no:
000687r 2  18             clc
000688r 2  60             rts
000689r 2               
000689r 2               ; CountDigit — count how many times SUB can be subtracted from SC_TMP
000689r 2               ; Out: A = ASCII digit ('0'-'9')
000689r 2               CountDigit:
000689r 2  A9 00          lda #0
00068Br 2  85 5F          sta DIGIT_COUNT
00068Dr 2               @loop:
00068Dr 2  20 rr rr       jsr Sub16IfGE
000690r 2  90 05          bcc @done
000692r 2  E6 5F          inc DIGIT_COUNT
000694r 2  4C rr rr       jmp @loop
000697r 2               @done:
000697r 2  A5 5F          lda DIGIT_COUNT
000699r 2  18             clc
00069Ar 2  69 30          adc #'0'
00069Cr 2  60             rts
00069Dr 2               
00069Dr 2               ; ValueToDigits — convert a 16-bit value into 5 ASCII digits in DIGIT_BUF
00069Dr 2               ; In: A = value low, X = value high
00069Dr 2               ValueToDigits:
00069Dr 2  85 5B          sta SC_TMP_LO
00069Fr 2  86 5C          stx SC_TMP_HI
0006A1r 2               
0006A1r 2  A9 10          lda #<10000
0006A3r 2  85 5D          sta SUB_LO
0006A5r 2  A9 27          lda #>10000
0006A7r 2  85 5E          sta SUB_HI
0006A9r 2  20 rr rr       jsr CountDigit
0006ACr 2  85 4E          sta DIGIT_BUF+0
0006AEr 2               
0006AEr 2  A9 E8          lda #<1000
0006B0r 2  85 5D          sta SUB_LO
0006B2r 2  A9 03          lda #>1000
0006B4r 2  85 5E          sta SUB_HI
0006B6r 2  20 rr rr       jsr CountDigit
0006B9r 2  85 4F          sta DIGIT_BUF+1
0006BBr 2               
0006BBr 2  A9 64          lda #<100
0006BDr 2  85 5D          sta SUB_LO
0006BFr 2  A9 00          lda #>100
0006C1r 2  85 5E          sta SUB_HI
0006C3r 2  20 rr rr       jsr CountDigit
0006C6r 2  85 50          sta DIGIT_BUF+2
0006C8r 2               
0006C8r 2  A9 0A          lda #<10
0006CAr 2  85 5D          sta SUB_LO
0006CCr 2  A9 00          lda #>10
0006CEr 2  85 5E          sta SUB_HI
0006D0r 2  20 rr rr       jsr CountDigit
0006D3r 2  85 51          sta DIGIT_BUF+3
0006D5r 2               
0006D5r 2  A5 5B          lda SC_TMP_LO
0006D7r 2  18             clc
0006D8r 2  69 30          adc #'0'
0006DAr 2  85 52          sta DIGIT_BUF+4
0006DCr 2  60             rts
0006DDr 2               
0006DDr 2               ; UpdateHud — redraw the score digits at row 0, columns 8-12
0006DDr 2               UpdateHud:
0006DDr 2  A5 44          lda SCORE_LO
0006DFr 2  A6 45          ldx SCORE_HI
0006E1r 2  20 rr rr       jsr ValueToDigits
0006E4r 2  A9 00          lda #0
0006E6r 2  A2 08          ldx #8
0006E8r 2  4C rr rr       jmp DrawDigitBuf
0006EBr 2               
0006EBr 2               ; DrawDigitBuf — draw the 5 ASCII digits currently in DIGIT_BUF at (row,col)
0006EBr 2               ; In: A = row, X = col
0006EBr 2               DrawDigitBuf:
0006EBr 2  85 63          sta MSG_ROW
0006EDr 2  86 4D          stx SCAN_TMP
0006EFr 2  64 5A          stz STR_IDX
0006F1r 2               @loop:
0006F1r 2  A4 5A          ldy STR_IDX
0006F3r 2  B9 4E 00       lda DIGIT_BUF,y
0006F6r 2  A8             tay
0006F7r 2  A5 63          lda MSG_ROW
0006F9r 2  A6 4D          ldx SCAN_TMP
0006FBr 2  20 rr rr       jsr DrawTile
0006FEr 2  E6 4D          inc SCAN_TMP
000700r 2  E6 5A          inc STR_IDX
000702r 2  A5 5A          lda STR_IDX
000704r 2  C9 05          cmp #5
000706r 2  D0 E9          bne @loop
000708r 2  60             rts
000709r 2               
000709r 2               ; DrawString — draw a null-terminated string starting at (row,col)
000709r 2               ; In: A = row, X = col, WORK_PTR/WORK_PTR+1 = string pointer
000709r 2               DrawString:
000709r 2  85 63          sta MSG_ROW
00070Br 2  86 4D          stx SCAN_TMP
00070Dr 2  64 5A          stz STR_IDX
00070Fr 2               @loop:
00070Fr 2  A4 5A          ldy STR_IDX
000711r 2  B1 56          lda (WORK_PTR),y
000713r 2  F0 0F          beq @done
000715r 2  A8             tay
000716r 2  A5 63          lda MSG_ROW
000718r 2  A6 4D          ldx SCAN_TMP
00071Ar 2  20 rr rr       jsr DrawTile
00071Dr 2  E6 4D          inc SCAN_TMP
00071Fr 2  E6 5A          inc STR_IDX
000721r 2  4C rr rr       jmp @loop
000724r 2               @done:
000724r 2  60             rts
000725r 2               
000725r 2               ; ClearRow — blank an entire row
000725r 2               ; In: A = row
000725r 2               ClearRow:
000725r 2  85 63          sta MSG_ROW
000727r 2  64 4D          stz SCAN_TMP
000729r 2               @loop:
000729r 2  A5 63          lda MSG_ROW
00072Br 2  A6 4D          ldx SCAN_TMP
00072Dr 2  20 rr rr       jsr EraseTile
000730r 2  E6 4D          inc SCAN_TMP
000732r 2  A5 4D          lda SCAN_TMP
000734r 2  C9 20          cmp #GRID_COLS
000736r 2  D0 F1          bne @loop
000738r 2  60             rts
000739r 2               
000739r 2               ; DrawHudLabel — draw the static "SCORE:" label at row 0, column 1
000739r 2               DrawHudLabel:
000739r 2  A9 rr          lda #<ScoreLabel
00073Br 2  85 56          sta WORK_PTR
00073Dr 2  A9 rr          lda #>ScoreLabel
00073Fr 2  85 57          sta WORK_PTR+1
000741r 2  A9 00          lda #0
000743r 2  A2 01          ldx #1
000745r 2  4C rr rr       jmp DrawString
000748r 2               
000748r 2               ; DrawGameOverOverlay — draw a highlighted box centered on the board with
000748r 2               ; the final score and, if this round set a new record, a callout for it
000748r 2               ; (otherwise the standing high score, for reference).
000748r 2               DrawGameOverOverlay:
000748r 2  20 rr rr       jsr DrawBoxFrame
00074Br 2  20 rr rr       jsr ClearBoxInterior
00074Er 2               
00074Er 2  A9 rr          lda #<GameOverTitleMsg
000750r 2  85 56          sta WORK_PTR
000752r 2  A9 rr          lda #>GameOverTitleMsg
000754r 2  85 57          sta WORK_PTR+1
000756r 2  A9 0A          lda #(BOX_TOP+2)
000758r 2  A2 0B          ldx #11
00075Ar 2  20 rr rr       jsr DrawString
00075Dr 2               
00075Dr 2  A9 rr          lda #<ScoreLabel2
00075Fr 2  85 56          sta WORK_PTR
000761r 2  A9 rr          lda #>ScoreLabel2
000763r 2  85 57          sta WORK_PTR+1
000765r 2  A9 0B          lda #(BOX_TOP+3)
000767r 2  A2 0A          ldx #10
000769r 2  20 rr rr       jsr DrawString
00076Cr 2  A5 44          lda SCORE_LO
00076Er 2  A6 45          ldx SCORE_HI
000770r 2  20 rr rr       jsr ValueToDigits
000773r 2  A9 0B          lda #(BOX_TOP+3)
000775r 2  A2 11          ldx #17
000777r 2  20 rr rr       jsr DrawDigitBuf
00077Ar 2               
00077Ar 2  A5 67          lda NEW_HIGH_FLAG
00077Cr 2  F0 12          beq @showHighRef
00077Er 2               
00077Er 2  A9 rr          lda #<NewHighMsg
000780r 2  85 56          sta WORK_PTR
000782r 2  A9 rr          lda #>NewHighMsg
000784r 2  85 57          sta WORK_PTR+1
000786r 2  A9 0C          lda #(BOX_TOP+4)
000788r 2  A2 08          ldx #8
00078Ar 2  20 rr rr       jsr DrawString
00078Dr 2  4C rr rr       jmp @afterHighLine
000790r 2               
000790r 2               @showHighRef:
000790r 2  A9 rr          lda #<HighLabelMsg
000792r 2  85 56          sta WORK_PTR
000794r 2  A9 rr          lda #>HighLabelMsg
000796r 2  85 57          sta WORK_PTR+1
000798r 2  A9 0C          lda #(BOX_TOP+4)
00079Ar 2  A2 0A          ldx #10
00079Cr 2  20 rr rr       jsr DrawString
00079Fr 2  A5 65          lda HIGH_SCORE_LO
0007A1r 2  A6 66          ldx HIGH_SCORE_HI
0007A3r 2  20 rr rr       jsr ValueToDigits
0007A6r 2  A9 0C          lda #(BOX_TOP+4)
0007A8r 2  A2 11          ldx #17
0007AAr 2  20 rr rr       jsr DrawDigitBuf
0007ADr 2               
0007ADr 2               @afterHighLine:
0007ADr 2  A9 rr          lda #<PressFireMsg
0007AFr 2  85 56          sta WORK_PTR
0007B1r 2  A9 rr          lda #>PressFireMsg
0007B3r 2  85 57          sta WORK_PTR+1
0007B5r 2  A9 0D          lda #(BOX_TOP+5)
0007B7r 2  A2 0B          ldx #11
0007B9r 2  4C rr rr       jmp DrawString
0007BCr 2               
0007BCr 2               ; DrawPauseMessage — draw the paused text at row 23
0007BCr 2               DrawPauseMessage:
0007BCr 2  A9 rr          lda #<PauseMsg
0007BEr 2  85 56          sta WORK_PTR
0007C0r 2  A9 rr          lda #>PauseMsg
0007C2r 2  85 57          sta WORK_PTR+1
0007C4r 2  A9 17          lda #23
0007C6r 2  A2 06          ldx #6
0007C8r 2  4C rr rr       jmp DrawString
0007CBr 2               
0007CBr 2               ScoreLabel:
0007CBr 2  53 43 4F 52    .byte "SCORE:", $00
0007CFr 2  45 3A 00     
0007D2r 2               
