000825r 2               
000825r 2               HighScoreLabel:
000825r 2  48 49 47 48    .byte "HIGH SCORE: ", $00
000829r 2  20 53 43 4F  
00082Dr 2  52 45 3A 20  
000832r 2               
000832r 2               MoveHelpMsg:
000832r 2  4D 4F 56 45    .byte "MOVE: WASD / ARROWS / JOYSTICK", $00
000836r 2  3A 20 57 41  
00083Ar 2  53 44 20 2F  
000851r 2               
000851r 2               StartPromptMsg:
000851r 2  50 52 45 53    .byte "PRESS SPACE OR FIRE TO START", $00
000855r 2  53 20 53 50  
000859r 2  41 43 45 20  
00086Er 2               
00086Er 1               
00086Er 1               GAME_SPEED_LO = 15    ; SysDelay units are centiseconds (10ms) -> ~150ms/tick
00086Er 1               GAME_SPEED_HI = 0
00086Er 1               
00086Er 1               ; =============================================================================
00086Er 1               ;   CartReset — cartridge entry point
00086Er 1               ; =============================================================================
00086Er 1               CartReset:
00086Er 1  A2 FF          ldx #$ff
000870r 1  9A             txs                            ; Reset the stack pointer
000871r 1  20 78 A0       jsr KernalInit                 ; Initialize all detected hardware
000874r 1               
000874r 1  20 30 A0       jsr Beep                       ; Startup beep (skips silently if no SID)
000877r 1  58             cli                             ; Enable interrupts
000878r 1               
000878r 1  20 15 A0       jsr InitVideo                  ; side effect: loads CP437 font into VRAM,
00087Br 1                                                  ; which InitGraphicsI below depends on
00087Br 1  20 rr rr       jsr LoadHighScore               ; from RTC NVRAM if fitted, else 0 (session-only)
00087Er 1               
00087Er 1  A9 01          lda #1
000880r 1  20 0F A0       jsr SetIOMode                   ; serial, so Chrin's echo can't smear our VRAM
000883r 1               
000883r 1  20 rr rr       jsr InitGraphicsI               ; also draws the border and blanks the screen
000886r 1  20 rr rr       jsr DrawTitleScreen              ; same tiles/colors/palette as gameplay
000889r 1               
000889r 1  20 rr rr       jsr WaitForStart                ; blocks until fire/space, seeds RNG_STATE
00088Cr 1               
00088Cr 1  20 rr rr       jsr NewGame
00088Fr 1               
00088Fr 1               ; -----------------------------------------------------------------------------
00088Fr 1               ; MainLoop
00088Fr 1               ; -----------------------------------------------------------------------------
00088Fr 1               MainLoop:
00088Fr 1  20 rr rr       jsr PollInput
000892r 1               
000892r 1  A5 3A          lda GAME_STATE
000894r 1  C9 01          cmp #STATE_PLAYING
000896r 1  D0 14          bne @notPlaying
000898r 1  A5 62          lda FIRE_EDGE
00089Ar 1  F0 0A          beq @doTick
00089Cr 1  A9 03          lda #STATE_PAUSED
00089Er 1  85 3A          sta GAME_STATE
0008A0r 1  20 rr rr       jsr DrawPauseMessage
0008A3r 1  4C rr rr       jmp @delay
0008A6r 1               @doTick:
0008A6r 1  20 rr rr       jsr Tick
0008A9r 1  4C rr rr       jmp @delay
0008ACr 1               
0008ACr 1               @notPlaying:
0008ACr 1  C9 03          cmp #STATE_PAUSED
0008AEr 1  D0 10          bne @notPaused
0008B0r 1  A5 62          lda FIRE_EDGE
0008B2r 1  F0 17          beq @delay
0008B4r 1  A9 01          lda #STATE_PLAYING
0008B6r 1  85 3A          sta GAME_STATE
0008B8r 1  A9 17          lda #23
0008BAr 1  20 rr rr       jsr ClearRow
0008BDr 1  4C rr rr       jmp @delay
0008C0r 1               
0008C0r 1               @notPaused:
0008C0r 1  C9 02          cmp #STATE_GAMEOVER
0008C2r 1  D0 07          bne @delay
0008C4r 1  A5 62          lda FIRE_EDGE
0008C6r 1  F0 03          beq @delay
0008C8r 1  20 rr rr       jsr NewGame
0008CBr 1               
0008CBr 1               @delay:
0008CBr 1  A9 0F          lda #GAME_SPEED_LO
0008CDr 1  A2 00          ldx #GAME_SPEED_HI
0008CFr 1  20 75 A0       jsr SysDelay
0008D2r 1  4C rr rr       jmp MainLoop
0008D5r 1               
0008D5r 1               ; =============================================================================
0008D5r 1               ;   IRQ / NMI handlers — cartridge owns the vectors, so it must supply these.
0008D5r 1               ;   Both just dispatch through the RAM vectors KernalInit already configured
0008D5r 1               ;   (default keyboard-scanning IRQ handler, no-op NMI).
0008D5r 1               ; =============================================================================
0008D5r 1               
0008D5r 1               IrqTrampoline:
0008D5r 1  6C 00 03       jmp (IRQ_PTR)
0008D8r 1               
0008D8r 1               NmiTrampoline:
0008D8r 1  6C 04 03       jmp (NMI_PTR)
0008DBr 1               
0008DBr 1               ; =============================================================================
0008DBr 1               ;   CPU Vectors — cart owns $FFFA-$FFFF
0008DBr 1               ; =============================================================================
0008DBr 1               
0008DBr 1               .segment "VECTORS"
000000r 1               
000000r 1  rr rr        .word   NmiTrampoline
000002r 1  rr rr        .word   CartReset
000004r 1  rr rr        .word   IrqTrampoline
000004r 1               
