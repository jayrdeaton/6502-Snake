000808r 2  48 49 47 48    .byte "HIGH:  ", $00   ; extra space vs "SCORE: " so the digits line up
00080Cr 2  3A 20 20 00  
000810r 2               
000810r 2               PressFireMsg:
000810r 2  50 52 45 53    .byte "PRESS FIRE", $00
000814r 2  53 20 46 49  
